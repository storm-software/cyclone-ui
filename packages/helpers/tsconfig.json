{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "tsBuildInfoFile": "../../dist/out-tsc/packages/helpers/tsconfig.tsbuildinfo",
    "jsx": "react-jsx",
    "rootDir": ".",
    "types": [
      "node",
      "@nx/react/typings/cssmodule.d.ts",
      "@nx/react/typings/image.d.ts"
    ],
    "outDir": "../../dist/out-tsc",
    "ignoreDeprecations": "6.0"
  },
  "files": [],
  "include": [
    "src/**/*.ts",
    "src/**/*.js",
    "powerlines.config.ts",
    "powerlines.d.ts"
  ],
  "exclude": ["vitest.config.mts", "src/**/*.spec.ts", "src/**/*.test.ts"]
}
