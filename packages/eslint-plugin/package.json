{
  "name": "@cyclone-ui/eslint-plugin",
  "version": "0.0.5",
  "type": "module",
  "description": "Cyclone UI ESLint plugin package",
  "repository": {
    "type": "github",
    "url": "https://github.com/storm-software/cyclone-ui.git",
    "directory": "packages/eslint-plugin"
  },
  "private": false,
  "dependencies": {
    "@razorwind/eslint": "catalog:"
  },
  "devDependencies": {
    "@powerlines/plugin-tsdown": "catalog:",
    "powerlines": "catalog:"
  },
  "publishConfig": {
    "access": "public"
  },
  "main": "./dist/index.cjs",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.cts",
  "exports": {
    ".": {
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      },
      "import": {
        "types": "./dist/index.d.mts",
        "default": "./dist/index.mjs"
      },
      "default": {
        "types": "./dist/index.d.mts",
        "default": "./dist/index.mjs"
      }
    },
    "./*": "./*",
    "./rolldown-runtime-CenpyGzJ": "./dist/rolldown-runtime-CenpyGzJ.mjs",
    "./runtime": {
      "require": {
        "types": "./dist/runtime.d.cts",
        "default": "./dist/runtime.cjs"
      },
      "import": {
        "types": "./dist/runtime.d.mts",
        "default": "./dist/runtime.mjs"
      },
      "default": {
        "types": "./dist/runtime.d.mts",
        "default": "./dist/runtime.mjs"
      }
    }
  }
}
