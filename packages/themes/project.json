{
  "name": "themes",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "projectType": "library",
  "sourceRoot": "packages/themes/src",
  "targets": {
    "build-base": {
      "dependsOn": ["monorepo:generate-tokens"],
      "executor": "@powerlines/nx:build",
      "options": {
        "configFile": "powerlines.config.ts"
      }
    },
    "build": {
      "dependsOn": ["build-base"],
      "executor": "nx:run-commands",
      "options": {
        "commands": [
          "pnpm exec copyfiles -u 1 packages/themes/dist/**/* dist/packages/themes/dist"
        ]
      }
    },
    "nx-release-publish": {
      "executor": "@storm-software/workspace-tools:npm-publish"
    }
  }
}
