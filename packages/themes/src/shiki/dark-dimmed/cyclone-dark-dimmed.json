{
  "name": "cyclone-darkDimmed",
  "settings": [
    {
      "scope": [
        "comment",
        "punctuation.definition.comment"
      ],
      "settings": {
        "foreground": "{color.neutral.8}",
        "fontStyle": "italic"
      }
    },
    {
      "scope": [
        "string",
        "constant.other.symbol"
      ],
      "settings": {
        "foreground": "{color.green.4}"
      }
    },
    {
      "scope": [
        "constant",
        "constant.numeric",
        "constant.language"
      ],
      "settings": {
        "foreground": "{color.yellow.4}"
      }
    },
    {
      "scope": [
        "keyword",
        "storage",
        "storage.type"
      ],
      "settings": {
        "foreground": "#5abba5"
      }
    },
    {
      "scope": [
        "entity.name.function",
        "support.function"
      ],
      "settings": {
        "foreground": "#5abba5"
      }
    },
    {
      "scope": [
        "entity.name.type",
        "entity.other.inherited-class",
        "support.type"
      ],
      "settings": {
        "foreground": "{color.purple.4}"
      }
    },
    {
      "scope": [
        "entity.name.tag",
        "meta.tag"
      ],
      "settings": {
        "foreground": "#5abba5"
      }
    },
    {
      "scope": [
        "entity.other.attribute-name",
        "support.constant"
      ],
      "settings": {
        "foreground": "{color.blue.4}"
      }
    },
    {
      "scope": [
        "variable",
        "identifier"
      ],
      "settings": {
        "foreground": "{color.neutral.6}"
      }
    },
    {
      "scope": [
        "punctuation",
        "meta.brace"
      ],
      "settings": {
        "foreground": "{color.neutral.8}"
      }
    },
    {
      "scope": [
        "invalid",
        "invalid.illegal"
      ],
      "settings": {
        "foreground": "{color.red.5}"
      }
    }
  ],
  "displayName": "Cyclone Light",
  "type": "darkDimmed",
  "fg": "{color.neutral.2}",
  "bg": "{color.neutral.14}",
  "colors": {
    "editor.background": "{color.neutral.14}",
    "editor.foreground": "{color.neutral.2}",
    "editorCursor.foreground": "{color.blue.5}",
    "editor.selectionBackground": "#258069",
    "editor.inactiveSelectionBackground": "{color.black}",
    "editorLineNumber.foreground": "{color.neutral.8}",
    "editorLineNumber.activeForeground": "{color.neutral.6}",
    "editorIndentGuide.background1": "{color.neutral.8}",
    "editorIndentGuide.activeBackground1": "{color.neutral.8}",
    "editorWhitespace.foreground": "{color.neutral.8}"
  }
}
