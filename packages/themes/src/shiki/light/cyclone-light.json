{
  "name": "cyclone-light",
  "settings": [
    {
      "scope": [
        "comment",
        "punctuation.definition.comment"
      ],
      "settings": {
        "foreground": "{color.neutral.6}",
        "fontStyle": "italic"
      }
    },
    {
      "scope": [
        "string",
        "constant.other.symbol"
      ],
      "settings": {
        "foreground": "{color.green.7}"
      }
    },
    {
      "scope": [
        "constant",
        "constant.numeric",
        "constant.language"
      ],
      "settings": {
        "foreground": "{color.yellow.9}"
      }
    },
    {
      "scope": [
        "keyword",
        "storage",
        "storage.type"
      ],
      "settings": {
        "foreground": "#1fb2a6"
      }
    },
    {
      "scope": [
        "entity.name.function",
        "support.function"
      ],
      "settings": {
        "foreground": "#1fb2a6"
      }
    },
    {
      "scope": [
        "entity.name.type",
        "entity.other.inherited-class",
        "support.type"
      ],
      "settings": {
        "foreground": "{color.purple.7}"
      }
    },
    {
      "scope": [
        "entity.name.tag",
        "meta.tag"
      ],
      "settings": {
        "foreground": "#1fb2a6"
      }
    },
    {
      "scope": [
        "entity.other.attribute-name",
        "support.constant"
      ],
      "settings": {
        "foreground": "{color.blue.7}"
      }
    },
    {
      "scope": [
        "variable",
        "identifier"
      ],
      "settings": {
        "foreground": "{color.neutral.9}"
      }
    },
    {
      "scope": [
        "punctuation",
        "meta.brace"
      ],
      "settings": {
        "foreground": "{color.neutral.6}"
      }
    },
    {
      "scope": [
        "invalid",
        "invalid.illegal"
      ],
      "settings": {
        "foreground": "{color.red.7}"
      }
    }
  ],
  "displayName": "Cyclone Light",
  "type": "light",
  "fg": "{color.neutral.11}",
  "bg": "{color.neutral.3}",
  "colors": {
    "editor.background": "{color.neutral.3}",
    "editor.foreground": "{color.neutral.11}",
    "editorCursor.foreground": "{color.blue.7}",
    "editor.selectionBackground": "#68e8db",
    "editor.inactiveSelectionBackground": "{color.neutral.4}",
    "editorLineNumber.foreground": "{color.neutral.6}",
    "editorLineNumber.activeForeground": "{color.neutral.9}",
    "editorIndentGuide.background1": "{color.neutral.6}",
    "editorIndentGuide.activeBackground1": "{color.neutral.6}",
    "editorWhitespace.foreground": "{color.neutral.6}"
  }
}
