{
  "name": "cyclone-light",
  "settings": [
    {
      "scope": [
        "comment",
        "punctuation.definition.comment"
      ],
      "settings": {
        "foreground": "#fafafa",
        "fontStyle": "italic"
      }
    },
    {
      "scope": [
        "string",
        "constant.other.symbol"
      ],
      "settings": {
        "foreground": "#fafafa"
      }
    },
    {
      "scope": [
        "constant",
        "constant.numeric",
        "constant.language"
      ],
      "settings": {
        "foreground": "#fafafa"
      }
    },
    {
      "scope": [
        "keyword",
        "storage",
        "storage.type"
      ],
      "settings": {
        "foreground": "#fafafa"
      }
    },
    {
      "scope": [
        "entity.name.function",
        "support.function"
      ],
      "settings": {
        "foreground": "#fafafa"
      }
    },
    {
      "scope": [
        "entity.name.type",
        "entity.other.inherited-class",
        "support.type"
      ],
      "settings": {
        "foreground": "#fafafa"
      }
    },
    {
      "scope": [
        "entity.name.tag",
        "meta.tag"
      ],
      "settings": {
        "foreground": "#fafafa"
      }
    },
    {
      "scope": [
        "entity.other.attribute-name",
        "support.constant"
      ],
      "settings": {
        "foreground": "#fafafa"
      }
    },
    {
      "scope": [
        "variable",
        "identifier"
      ],
      "settings": {
        "foreground": "#fafafa"
      }
    },
    {
      "scope": [
        "punctuation",
        "meta.brace"
      ],
      "settings": {
        "foreground": "#fafafa"
      }
    },
    {
      "scope": [
        "invalid",
        "invalid.illegal"
      ],
      "settings": {
        "foreground": "#fafafa"
      }
    }
  ],
  "displayName": "Cyclone Light",
  "type": "light",
  "fg": "#fafafa",
  "bg": "#fafafa",
  "colors": {
    "editor.background": "#fafafa",
    "editor.foreground": "#fafafa",
    "editorCursor.foreground": "#fafafa",
    "editor.selectionBackground": "#fafafa",
    "editor.inactiveSelectionBackground": "#fafafa",
    "editorLineNumber.foreground": "#fafafa",
    "editorLineNumber.activeForeground": "#fafafa",
    "editorIndentGuide.background1": "#fafafa",
    "editorIndentGuide.activeBackground1": "#fafafa",
    "editorWhitespace.foreground": "#fafafa"
  }
}
