{
  "name": "cli",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "projectType": "application",
  "sourceRoot": "packages/cli/src",
  "targets": {
    "build": {
      "executor": "@shell-shock/nx:build",
      "dependsOn": ["^build"],
      "defaultConfiguration": "production",
      "options": {
        "configFile": "packages/cli/shell-shock.config.ts",
        "outputPath": "packages/cli/dist",
        "copyPath": "dist/packages/cli"
      },
      "configurations": {
        "production": {
          "mode": "production"
        },
        "development": {
          "mode": "development",
          "skipCache": true
        }
      }
    },
    "nx-release-publish": {
      "executor": "@storm-software/workspace-tools:npm-publish"
    }
  }
}
