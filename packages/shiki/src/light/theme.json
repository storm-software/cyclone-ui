{
  "name": "cyclone-light",
  "settings": [
    {
      "scope": [
        "comment",
        "punctuation.definition.comment"
      ],
      "settings": {
        "foreground": "#959698",
        "fontStyle": "italic"
      }
    },
    {
      "scope": [
        "string",
        "constant.other.symbol"
      ],
      "settings": {
        "foreground": "#216b53"
      }
    },
    {
      "scope": [
        "constant",
        "constant.numeric",
        "constant.language"
      ],
      "settings": {
        "foreground": "#765417"
      }
    },
    {
      "scope": [
        "keyword",
        "storage",
        "storage.type"
      ],
      "settings": {
        "foreground": "#2055b3"
      }
    },
    {
      "scope": [
        "entity.name.function",
        "support.function"
      ],
      "settings": {
        "foreground": "#2055b3"
      }
    },
    {
      "scope": [
        "entity.name.type",
        "entity.other.inherited-class",
        "support.type"
      ],
      "settings": {
        "foreground": "#594395"
      }
    },
    {
      "scope": [
        "entity.name.tag",
        "meta.tag"
      ],
      "settings": {
        "foreground": "#2055b3"
      }
    },
    {
      "scope": [
        "entity.other.attribute-name",
        "support.constant"
      ],
      "settings": {
        "foreground": "#2055b3"
      }
    },
    {
      "scope": [
        "variable",
        "identifier"
      ],
      "settings": {
        "foreground": "#555659"
      }
    },
    {
      "scope": [
        "punctuation",
        "meta.brace"
      ],
      "settings": {
        "foreground": "#959698"
      }
    },
    {
      "scope": [
        "invalid",
        "invalid.illegal"
      ],
      "settings": {
        "foreground": "#8e223e"
      }
    }
  ],
  "displayName": "Cyclone Light",
  "type": "light",
  "fg": "#242528",
  "bg": "#eaeaea",
  "colors": {
    "editor.background": "#eaeaea",
    "editor.foreground": "#242528",
    "editorCursor.foreground": "#2055b3",
    "editor.selectionBackground": "#242528",
    "editor.selectionForeground": "#eaeaea",
    "editor.inactiveSelectionBackground": "#f1f1f1",
    "editorLineNumber.foreground": "#959698",
    "editorLineNumber.activeForeground": "#555659",
    "editorIndentGuide.background1": "#d0d0d1",
    "editorIndentGuide.activeBackground1": "#959698",
    "editorWhitespace.foreground": "#959698"
  }
}
