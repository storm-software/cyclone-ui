{
  "name": "cyclone-dark-dimmed",
  "settings": [
    {
      "scope": ["comment", "punctuation.definition.comment"],
      "settings": {
        "foreground": "#8f8f90",
        "fontStyle": "italic"
      }
    },
    {
      "scope": ["string", "constant.other.symbol"],
      "settings": {
        "foreground": "#60a88a"
      }
    },
    {
      "scope": ["constant", "constant.numeric", "constant.language"],
      "settings": {
        "foreground": "#d0ad6d"
      }
    },
    {
      "scope": ["keyword", "storage", "storage.type"],
      "settings": {
        "foreground": "#638cd2"
      }
    },
    {
      "scope": ["entity.name.function", "support.function"],
      "settings": {
        "foreground": "#638cd2"
      }
    },
    {
      "scope": [
        "entity.name.type",
        "entity.other.inherited-class",
        "support.type"
      ],
      "settings": {
        "foreground": "#8e7dbb"
      }
    },
    {
      "scope": ["entity.name.tag", "meta.tag"],
      "settings": {
        "foreground": "#638cd2"
      }
    },
    {
      "scope": ["entity.other.attribute-name", "support.constant"],
      "settings": {
        "foreground": "#638cd2"
      }
    },
    {
      "scope": ["variable", "identifier"],
      "settings": {
        "foreground": "#a1a1a2"
      }
    },
    {
      "scope": ["punctuation", "meta.brace"],
      "settings": {
        "foreground": "#8f8f90"
      }
    },
    {
      "scope": ["invalid", "invalid.illegal"],
      "settings": {
        "foreground": "#b15e73"
      }
    }
  ],
  "displayName": "Cyclone Light",
  "type": "darkDimmed",
  "fg": "#cfcfcf",
  "bg": "#343438",
  "colors": {
    "editor.background": "#343438",
    "editor.foreground": "#cfcfcf",
    "editorCursor.foreground": "#638cd2",
    "editor.selectionBackground": "#cfcfcf",
    "editor.selectionForeground": "#343438",
    "editor.inactiveSelectionBackground": "#39393c",
    "editorLineNumber.foreground": "#8f8f90",
    "editorLineNumber.activeForeground": "#a1a1a2",
    "editorIndentGuide.background1": "#8f8f90",
    "editorIndentGuide.activeBackground1": "#8f8f90",
    "editorWhitespace.foreground": "#8f8f90"
  }
}
