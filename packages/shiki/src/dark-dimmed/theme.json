{
  "name": "cyclone-dark-dimmed",
  "settings": [
    {
      "scope": [
        "comment",
        "punctuation.definition.comment"
      ],
      "settings": {
        "foreground": "#57575a",
        "fontStyle": "italic"
      }
    },
    {
      "scope": [
        "string",
        "constant.other.symbol"
      ],
      "settings": {
        "foreground": "#60a88a"
      }
    },
    {
      "scope": [
        "constant",
        "constant.numeric",
        "constant.language"
      ],
      "settings": {
        "foreground": "#c59b4d"
      }
    },
    {
      "scope": [
        "keyword",
        "storage",
        "storage.type"
      ],
      "settings": {
        "foreground": "#638cd2"
      }
    },
    {
      "scope": [
        "entity.name.function",
        "support.function"
      ],
      "settings": {
        "foreground": "#638cd2"
      }
    },
    {
      "scope": [
        "entity.name.type",
        "entity.other.inherited-class",
        "support.type"
      ],
      "settings": {
        "foreground": "#8e7dbb"
      }
    },
    {
      "scope": [
        "entity.name.tag",
        "meta.tag"
      ],
      "settings": {
        "foreground": "#638cd2"
      }
    },
    {
      "scope": [
        "entity.other.attribute-name",
        "support.constant"
      ],
      "settings": {
        "foreground": "#638cd2"
      }
    },
    {
      "scope": [
        "variable",
        "identifier"
      ],
      "settings": {
        "foreground": "#b4b4b4"
      }
    },
    {
      "scope": [
        "punctuation",
        "meta.brace"
      ],
      "settings": {
        "foreground": "#57575a"
      }
    },
    {
      "scope": [
        "invalid",
        "invalid.illegal"
      ],
      "settings": {
        "foreground": "#ab5268"
      }
    }
  ],
  "displayName": "Cyclone Light",
  "type": "darkDimmed",
  "fg": "#cfcfcf",
  "bg": "#343438",
  "colors": {
    "editor.background": "#343438",
    "editor.foreground": "#cfcfcf",
    "editorCursor.foreground": "#638cd2",
    "editor.selectionBackground": "#cfcfcf",
    "editor.selectionForeground": "#343438",
    "editor.inactiveSelectionBackground": "#2e2e30",
    "editorLineNumber.foreground": "#57575a",
    "editorLineNumber.activeForeground": "#b4b4b4",
    "editorIndentGuide.background1": "#626364",
    "editorIndentGuide.activeBackground1": "#57575a",
    "editorWhitespace.foreground": "#57575a"
  }
}
