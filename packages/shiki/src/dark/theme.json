{
  "name": "cyclone-dark",
  "settings": [
    {
      "scope": [
        "comment",
        "punctuation.definition.comment"
      ],
      "settings": {
        "foreground": "#46464a",
        "fontStyle": "italic"
      }
    },
    {
      "scope": [
        "string",
        "constant.other.symbol"
      ],
      "settings": {
        "foreground": "#45c791"
      }
    },
    {
      "scope": [
        "constant",
        "constant.numeric",
        "constant.language"
      ],
      "settings": {
        "foreground": "#f7ac23"
      }
    },
    {
      "scope": [
        "keyword",
        "storage",
        "storage.type"
      ],
      "settings": {
        "foreground": "#4d8eff"
      }
    },
    {
      "scope": [
        "entity.name.function",
        "support.function"
      ],
      "settings": {
        "foreground": "#4d8eff"
      }
    },
    {
      "scope": [
        "entity.name.type",
        "entity.other.inherited-class",
        "support.type"
      ],
      "settings": {
        "foreground": "#9277da"
      }
    },
    {
      "scope": [
        "entity.name.tag",
        "meta.tag"
      ],
      "settings": {
        "foreground": "#4d8eff"
      }
    },
    {
      "scope": [
        "entity.other.attribute-name",
        "support.constant"
      ],
      "settings": {
        "foreground": "#4d8eff"
      }
    },
    {
      "scope": [
        "variable",
        "identifier"
      ],
      "settings": {
        "foreground": "#cacacb"
      }
    },
    {
      "scope": [
        "punctuation",
        "meta.brace"
      ],
      "settings": {
        "foreground": "#46464a"
      }
    },
    {
      "scope": [
        "invalid",
        "invalid.illegal"
      ],
      "settings": {
        "foreground": "#cf2d56"
      }
    }
  ],
  "displayName": "Cyclone Dark",
  "type": "dark",
  "fg": "#f1f1f1",
  "bg": "#151518",
  "colors": {
    "editor.background": "#151518",
    "editor.foreground": "#f1f1f1",
    "editorCursor.foreground": "#4d8eff",
    "editor.selectionBackground": "#f1f1f1",
    "editor.selectionForeground": "#151518",
    "editor.inactiveSelectionBackground": "#0c0c0d",
    "editorLineNumber.foreground": "#46464a",
    "editorLineNumber.activeForeground": "#cacacb",
    "editorIndentGuide.background1": "#555659",
    "editorIndentGuide.activeBackground1": "#46464a",
    "editorWhitespace.foreground": "#46464a"
  }
}
