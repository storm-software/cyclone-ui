{
  "name": "cyclone-light-high-contrast",
  "settings": [
    {
      "scope": ["comment", "punctuation.definition.comment"],
      "settings": {
        "foreground": "#9a9fa7",
        "fontStyle": "italic"
      }
    },
    {
      "scope": ["string", "constant.other.symbol"],
      "settings": {
        "foreground": "#0a4e38"
      }
    },
    {
      "scope": ["constant", "constant.numeric", "constant.language"],
      "settings": {
        "foreground": "#583902"
      }
    },
    {
      "scope": ["keyword", "storage", "storage.type"],
      "settings": {
        "foreground": "#0145be"
      }
    },
    {
      "scope": ["entity.name.function", "support.function"],
      "settings": {
        "foreground": "#0145be"
      }
    },
    {
      "scope": [
        "entity.name.type",
        "entity.other.inherited-class",
        "support.type"
      ],
      "settings": {
        "foreground": "#492b9b"
      }
    },
    {
      "scope": ["entity.name.tag", "meta.tag"],
      "settings": {
        "foreground": "#0145be"
      }
    },
    {
      "scope": ["entity.other.attribute-name", "support.constant"],
      "settings": {
        "foreground": "#0145be"
      }
    },
    {
      "scope": ["variable", "identifier"],
      "settings": {
        "foreground": "#3f424a"
      }
    },
    {
      "scope": ["punctuation", "meta.brace"],
      "settings": {
        "foreground": "#9a9fa7"
      }
    },
    {
      "scope": ["invalid", "invalid.illegal"],
      "settings": {
        "foreground": "#840929"
      }
    }
  ],
  "displayName": "Cyclone Light",
  "type": "lightHighContrast",
  "fg": "#000000",
  "bg": "#ffffff",
  "colors": {
    "editor.background": "#ffffff",
    "editor.foreground": "#000000",
    "editorCursor.foreground": "#0145be",
    "editor.selectionBackground": "#000000",
    "editor.selectionForeground": "#ffffff",
    "editor.inactiveSelectionBackground": "#ffffff",
    "editorLineNumber.foreground": "#9a9fa7",
    "editorLineNumber.activeForeground": "#3f424a",
    "editorIndentGuide.background1": "#dcdce0",
    "editorIndentGuide.activeBackground1": "#9a9fa7",
    "editorWhitespace.foreground": "#9a9fa7"
  }
}
