{
  "extends": "@storm-software/workspace-tools/config/recommended.json",
  "release": {
    "groups": {
      "packages": {
        "projects": ["packages/*", "components/*", "apps/*"],
        "projectsRelationship": "independent"
      }
    }
  },
  "plugins": [
    {
      "plugin": "@nx/js/typescript",
      "options": {
        "compiler": "tsgo",
        "typecheck": false,
        "build": false,
        "verboseOutput": false
      }
    },
    "@nx/vitest",
    "@storm-software/workspace-tools/plugins/typescript",
    "@storm-software/workspace-tools/plugins/typescript/untyped",
    "@storm-software/workspace-tools/plugins/typescript/tsdown",
    "@powerlines/nx/plugin",
    "@shell-shock/nx/plugin",
    {
      "plugin": "@razorwind/nx/plugin",
      "options": {
        "targetName": "generate-tokens"
      }
    },
    "./dist/nx-plugins/components.js",
    "./dist/nx-plugins/storybook.js"
  ],
  "sync": {
    "applyChanges": true,
    "globalGenerators": ["@nx/js:typescript-sync"]
  },
  "analytics": false
}
