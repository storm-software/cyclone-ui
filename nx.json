{
  "extends": "@storm-software/workspace-tools/config/recommended.json",
  "release": {
    "groups": {
      "packages": {
        "projects": ["packages/*", "components/*", "maps/styles/*"],
        "projectsRelationship": "independent"
      },
      "fonts": {
        "projects": ["fonts/*"],
        "projectsRelationship": "independent",
        "skipFormatting": true
      },
      "tiles": {
        "projects": ["maps-tiles"],
        "projectsRelationship": "independent",
        "version": {
          "versionActions": "@nx/js/src/release/version-actions"
        },
        "releaseTag": {
          "pattern": "{projectName}@{version}"
        },
        "docker": {
          "groupPreVersionCommand": "pnpm nx run maps-tiles:docker:build",
          "skipVersionActions": true,
          "versionSchemes": {
            "production": "{currentDate|YYMM.DD}.{shortCommitSha}"
          },
          "repositoryName": "storm-software/cyclone-ui-tiles",
          "registryUrl": "ghcr.io"
        }
      }
    }
  },
  "plugins": [
    {
      "plugin": "@nx/js/typescript",
      "options": {
        "compiler": "tsgo",
        "typecheck": false,
        "build": false,
        "verboseOutput": false
      }
    },
    {
      "plugin": "@nx/maven",
      "options": {
        "targetNamePrefix": "mvn-"
      }
    },
    {
      "plugin": "@nx/docker",
      "options": {
        "buildTarget": "docker:build",
        "runTarget": "docker:run"
      }
    },
    "@nx/vitest",
    "@storm-software/workspace-tools/plugins/typescript",
    "@storm-software/workspace-tools/plugins/typescript/untyped",
    "@storm-software/workspace-tools/plugins/typescript/tsdown",
    "@powerlines/nx/plugin",
    "@shell-shock/nx/plugin",
    {
      "plugin": "@razorwind/nx/plugin",
      "options": {
        "targetName": "build-tokens"
      }
    },
    "./dist/nx-plugins/components.js",
    "./dist/nx-plugins/fonts.js",
    "./dist/nx-plugins/storybook.js"
  ],
  "sync": {
    "applyChanges": true,
    "globalGenerators": ["@nx/js:typescript-sync"]
  },
  "analytics": false
}
