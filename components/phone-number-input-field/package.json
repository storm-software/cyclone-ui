  },
  "private": false,
  "files": ["dist"],
  "peerDependencies": {
    "react": "catalog:",
    "react-dom": "catalog:",
    "react-native": "catalog:"
  },
  "dependencies": {
    "@cyclone-ui/button": "workspace:*",
    "@cyclone-ui/input": "workspace:*",
    "@cyclone-ui/input-field": "workspace:*",
    "@cyclone-ui/popover": "workspace:*",
    "@cyclone-ui/state": "workspace:*",
    "@maskito/core": "catalog:",
    "@maskito/phone": "catalog:",
    "@tamagui/core": "catalog:",
    "@tamagui/lucide-icons-2": "catalog:",
    "@tamagui/text": "catalog:",
    "libphonenumber-js": "catalog:"
  },
  "devDependencies": {
    "@cyclone-ui/form": "workspace:*",
    "@storybook/react-vite": "catalog:",
    "react": "catalog:",
    "react-dom": "catalog:",
    "react-native": "catalog:"
  },
  "publishConfig": {
    "access": "public"
  },
  "sideEffects": ["*.css"],
