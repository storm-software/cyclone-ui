{
  "name": "@cyclone-ui/phone-number-input-field",
  "version": "0.0.12",
  "type": "module",
  "description": "A PhoneNumberInputField built on InputField that adds a searchable country-code picker with flags in a popover. Input is masked and formatted with libphonenumber-js and maskito, and the selected country updates from the entered value. It has a defaultCountry prop and the same Label, Control, Details and Icon parts as InputField. Use it for phone number entry inside a Form.",
  "repository": {
    "type": "github",
    "url": "https://github.com/storm-software/cyclone-ui.git",
    "directory": "components/phone-number-input-field"
  },
  "private": false,
  "files": [
    "dist"
  ],
  "peerDependencies": {
    "react": "catalog:",
    "react-dom": "catalog:",
    "react-native": "catalog:"
  },
  "dependencies": {
    "@cyclone-ui/body-text": "workspace:*",
    "@cyclone-ui/button": "workspace:*",
    "@cyclone-ui/helpers": "workspace:*",
    "@cyclone-ui/input": "workspace:*",
    "@cyclone-ui/input-field": "workspace:*",
    "@cyclone-ui/popover": "workspace:*",
    "@cyclone-ui/search-input-field": "workspace:*",
    "@cyclone-ui/state": "workspace:*",
    "@maskito/core": "catalog:",
    "@maskito/phone": "catalog:",
    "@tamagui/core": "catalog:",
    "@tamagui/text": "catalog:",
    "libphonenumber-js": "catalog:"
  },
  "devDependencies": {
    "@cyclone-ui/form": "workspace:*",
    "@storybook/react-vite": "catalog:",
    "react": "catalog:",
    "react-dom": "catalog:",
    "react-native": "catalog:"
  },
  "publishConfig": {
    "access": "public"
  },
  "sideEffects": [
    "*.css"
  ],
  "module:jsx": "dist/jsx",
  "main": "./dist/index.cjs",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.cts",
  "exports": {
    ".": {
      "import": "./dist/index.mjs",
      "require": "./dist/index.cjs"
    },
    "./PhoneNumberInputField": {
      "import": "./dist/PhoneNumberInputField.mjs",
      "require": "./dist/PhoneNumberInputField.cjs"
    },
    "./*": "./*"
  }
}
