{
  "name": "@cyclone-ui/radial-chart",
  "version": "0.0.4",
  "type": "module",
  "description": "A composable radial bar chart built on Recharts and the shared Cyclone chart parts. Each category is drawn as a ring, as a full circle or a semicircle, with gradient colors from the theme. It also supports legend selection and a loading skeleton. Use it to compare a few values as progress around a circle.",
  "repository": {
    "type": "github",
    "url": "https://github.com/storm-software/cyclone-ui.git",
    "directory": "components/radial-chart"
  },
  "private": false,
  "files": [
    "dist"
  ],
  "peerDependencies": {
    "react": "catalog:",
    "react-dom": "catalog:",
    "react-native": "catalog:"
  },
  "dependencies": {
    "@cyclone-ui/chart": "workspace:*",
    "motion": "catalog:",
    "recharts": "catalog:"
  },
  "devDependencies": {
    "@storybook/react-vite": "catalog:",
    "@tamagui/stacks": "catalog:",
    "react": "catalog:",
    "react-dom": "catalog:",
    "react-native": "catalog:"
  },
  "publishConfig": {
    "access": "public"
  },
  "sideEffects": [
    "*.css"
  ],
  "module:jsx": "dist/jsx",
  "main": "./dist/index.cjs",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.cts",
  "exports": {
    ".": {
      "import": "./dist/index.mjs",
      "require": "./dist/index.cjs"
    },
    "./RadialChart": {
      "import": "./dist/RadialChart.mjs",
      "require": "./dist/RadialChart.cjs"
    },
    "./*": "./*"
  }
}
