{
  "name": "@cyclone-ui/number-text",
  "version": "0.5.0",
  "type": "module",
  "description": "A visually hidden component meant to be shared in many other components",
  "repository": {
    "type": "github",
    "url": "https://github.com/storm-software/cyclone-ui.git",
    "directory": "components/number-text"
  },
  "private": false,
  "files": [
    "dist"
  ],
  "peerDependencies": {
    "react": "catalog:",
    "react-dom": "catalog:",
    "react-native": "catalog:"
  },
  "dependencies": {
    "@number-flow/react": "^0.4.4",
    "@tamagui/core": "catalog:",
    "@cyclone-ui/label-text": "workspace:*"
  },
  "devDependencies": {
    "@storybook/react-vite": "catalog:",
    "react": "catalog:",
    "react-dom": "catalog:",
    "react-native": "catalog:"
  },
  "publishConfig": {
    "access": "public"
  },
  "sideEffects": [
    "*.css"
  ],
  "module:jsx": "dist/jsx",
  "main": "./dist/index.cjs",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.cts",
  "exports": {
    ".": {
      "import": "./dist/index.mjs",
      "require": "./dist/index.cjs"
    },
    "./NumberText": {
      "import": "./dist/NumberText.mjs",
      "require": "./dist/NumberText.cjs"
    },
    "./*": "./*"
  }
}
