{
  "name": "@cyclone-ui/kbd",
  "version": "0.0.6",
  "type": "module",
  "description": "Keyboard keys and shortcuts shown inline, like shadcn/ui's Kbd. A `Kbd` renders a `<kbd>` key cap in a small bordered box, in `sm`, `md` or `lg`, that sits inside text, buttons and tooltips. A `KbdGroup` lays several keys out side by side for a combination such as Ctrl + K.",
  "repository": {
    "type": "github",
    "url": "https://github.com/storm-software/cyclone-ui.git",
    "directory": "components/kbd"
  },
  "private": false,
  "files": [
    "dist"
  ],
  "peerDependencies": {
    "react": "catalog:",
    "react-dom": "catalog:",
    "react-native": "catalog:"
  },
  "dependencies": {
    "@tamagui/core": "catalog:"
  },
  "devDependencies": {
    "@cyclone-ui/body-text": "workspace:*",
    "@cyclone-ui/button": "workspace:*",
    "@cyclone-ui/icons": "workspace:*",
    "@storybook/react-vite": "catalog:",
    "react": "catalog:",
    "react-dom": "catalog:",
    "react-native": "catalog:"
  },
  "publishConfig": {
    "access": "public"
  },
  "sideEffects": [
    "*.css"
  ],
  "main": "./dist/index.cjs",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.cts",
  "exports": {
    ".": {
      "import": "./dist/index.mjs",
      "require": "./dist/index.cjs"
    },
    "./Kbd": {
      "import": "./dist/Kbd.mjs",
      "require": "./dist/Kbd.cjs"
    },
    "./*": "./*"
  }
}
