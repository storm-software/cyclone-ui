{
  "name": "@cyclone-ui/input-field",
  "version": "0.1.11",
  "type": "module",
  "description": "A form-bound InputField compound component (Label, Link, Control with TextBox, Value and Trigger, Details, Icon) that connects an Input to the Cyclone UI form state. It uses a floating-label variant by default, supports start and end icons, has an optional clear button when the field is clearable, and syncs value, focus, size and disabled state. Use it for text inputs inside a Form.",
  "repository": {
    "type": "github",
    "url": "https://github.com/storm-software/cyclone-ui.git",
    "directory": "components/input-field"
  },
  "private": false,
  "files": ["dist"],
  "peerDependencies": {
    "react": "catalog:",
    "react-dom": "catalog:",
    "react-native": "catalog:"
  },
  "dependencies": {
    "@tamagui/core": "catalog:",
    "@tamagui/react-native-types": "catalog:",
    "@tamagui/create-context": "catalog:",
    "@cyclone-ui/icons": "workspace:*",
    "@cyclone-ui/field": "workspace:*",
    "@cyclone-ui/helpers": "workspace:*",
    "@cyclone-ui/input": "workspace:*",
    "@cyclone-ui/state": "workspace:*"
  },
  "devDependencies": {
    "@cyclone-ui/form": "workspace:*",
    "@storybook/react-vite": "catalog:",
    "react": "catalog:",
    "react-dom": "catalog:",
    "react-native": "catalog:"
  },
  "publishConfig": {
    "access": "public"
  },
  "sideEffects": ["*.css"],
  "module:jsx": "dist/jsx",
  "main": "./dist/index.cjs",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.cts",
  "exports": {
    ".": {
      "import": "./dist/index.mjs",
      "require": "./dist/index.cjs"
    },
    "./InputField": {
      "import": "./dist/InputField.mjs",
      "require": "./dist/InputField.cjs"
    },
    "./*": "./*"
  }
}
