{
  "name": "@cyclone-ui/floating-toolbar",
  "version": "0.0.5",
  "type": "module",
  "description": "A pill-shaped toolbar fixed to the bottom of the viewport for page-level controls: a frosted `floating` Container surface holding `Row`s of buttons, brand marks, selects and toggles separated by `Divider`s. Its `TableOfContents` part shows the heading the reader is in with a reading-progress ring and expands the page's TableOfContents upward in a Collapsible.",
  "repository": {
    "type": "github",
    "url": "https://github.com/storm-software/cyclone-ui.git",
    "directory": "components/floating-toolbar"
  },
  "private": false,
  "files": [
    "dist"
  ],
  "peerDependencies": {
    "react": "catalog:",
    "react-dom": "catalog:",
    "react-native": "catalog:"
  },
  "dependencies": {
    "@cyclone-ui/body-text": "workspace:*",
    "@cyclone-ui/circular-progress": "workspace:*",
    "@cyclone-ui/collapsible": "workspace:*",
    "@cyclone-ui/container": "workspace:*",
    "@cyclone-ui/divider": "workspace:*",
    "@cyclone-ui/icons": "workspace:*",
    "@cyclone-ui/table-of-contents": "workspace:*",
    "@tamagui/animate-presence": "catalog:",
    "@tamagui/core": "catalog:",
    "@tamagui/stacks": "catalog:"
  },
  "devDependencies": {
    "@cyclone-ui/button": "workspace:*",
    "@cyclone-ui/toggle-group": "workspace:*",
    "@storybook/react-vite": "catalog:",
    "react": "catalog:",
    "react-dom": "catalog:",
    "react-native": "catalog:"
  },
  "publishConfig": {
    "access": "public"
  },
  "sideEffects": [
    "*.css"
  ],
  "main": "./dist/index.cjs",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.cts",
  "exports": {
    ".": {
      "import": "./dist/index.mjs",
      "require": "./dist/index.cjs"
    },
    "./FloatingToolbar": {
      "import": "./dist/FloatingToolbar.mjs",
      "require": "./dist/FloatingToolbar.cjs"
    },
    "./utilities": {
      "import": "./dist/utilities.mjs",
      "require": "./dist/utilities.cjs"
    },
    "./*": "./*"
  }
}
