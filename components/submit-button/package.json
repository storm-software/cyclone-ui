{
  "name": "@cyclone-ui/submit-button",
  "version": "0.0.13",
  "type": "module",
  "description": "A Button preset labeled \"Submit\" by default, with a right-arrow icon that animates on hover. When onPress returns a promise, the label and arrow slide away into a spinner and \"Submitting\", then into a success or error state with its own text, icon and theme. The state can also be controlled with status. It accepts all Button props plus hideText to show only the icon and animateShrink for the arrow. Use it for submitting forms.",
  "repository": {
    "type": "github",
    "url": "https://github.com/storm-software/cyclone-ui.git",
    "directory": "components/submit-button"
  },
  "private": false,
  "files": [
    "dist"
  ],
  "peerDependencies": {
    "react": "catalog:",
    "react-dom": "catalog:",
    "react-native": "catalog:"
  },
  "dependencies": {
    "@cyclone-ui/button": "workspace:*",
    "@cyclone-ui/icons": "workspace:*",
    "@stryke/hooks": "catalog:",
    "@tamagui/core": "catalog:",
    "@tamagui/stacks": "catalog:"
  },
  "devDependencies": {
    "@storybook/react-vite": "catalog:",
    "react": "catalog:",
    "react-dom": "catalog:",
    "react-native": "catalog:"
  },
  "publishConfig": {
    "access": "public"
  },
  "sideEffects": [
    "*.css"
  ],
  "module:jsx": "dist/jsx",
  "main": "./dist/index.cjs",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.cts",
  "exports": {
    ".": {
      "import": "./dist/index.mjs",
      "require": "./dist/index.cjs"
    },
    "./SubmitButton": {
      "import": "./dist/SubmitButton.mjs",
      "require": "./dist/SubmitButton.cjs"
    },
    "./*": "./*"
  }
}
