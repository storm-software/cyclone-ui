{
  "name": "@cyclone-ui/number-input-field",
  "version": "0.0.12",
  "type": "module",
  "description": "A NumberInputField built on InputField that renders a type=number text box with decrease (minus) and increase (plus) buttons. The buttons change the form-bound value by a configurable increment. It has the same Label, Link, Control, Details and Icon parts as InputField. Use it for numeric entry inside a Form.",
  "repository": {
    "type": "github",
    "url": "https://github.com/storm-software/cyclone-ui.git",
    "directory": "components/number-input-field"
  },
  "private": false,
  "files": [
    "dist"
  ],
  "peerDependencies": {
    "react": "catalog:",
    "react-dom": "catalog:",
    "react-native": "catalog:"
  },
  "dependencies": {
    "@tamagui/core": "catalog:",
    "@cyclone-ui/icons": "workspace:*",
    "@cyclone-ui/input-field": "workspace:*",
    "@cyclone-ui/state": "workspace:*"
  },
  "devDependencies": {
    "@cyclone-ui/form": "workspace:*",
    "@storybook/react-vite": "catalog:",
    "react": "catalog:",
    "react-dom": "catalog:",
    "react-native": "catalog:"
  },
  "publishConfig": {
    "access": "public"
  },
  "sideEffects": [
    "*.css"
  ],
  "module:jsx": "dist/jsx",
  "main": "./dist/index.cjs",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.cts",
  "exports": {
    ".": {
      "import": "./dist/index.mjs",
      "require": "./dist/index.cjs"
    },
    "./NumberInputField": {
      "import": "./dist/NumberInputField.mjs",
      "require": "./dist/NumberInputField.cjs"
    },
    "./*": "./*"
  }
}
