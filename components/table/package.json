{
  "name": "@cyclone-ui/table",
  "version": "0.4.11",
  "type": "module",
  "description": "A Table compound component with Header, Body, Row, Cell, HeaderCell and Footer parts that render semantic table elements. Table-level props set cell width and height, fixed or content-based sizing, separate alignment for header cells and body cells, and the border color. Use it to show tabular data in rows and columns.",
  "repository": {
    "type": "github",
    "url": "https://github.com/storm-software/cyclone-ui.git",
    "directory": "components/table"
  },
  "private": false,
  "files": ["dist"],
  "peerDependencies": {
    "react": "catalog:",
    "react-dom": "catalog:",
    "react-native": "catalog:"
  },
  "dependencies": {
    "@cyclone-ui/heading-text": "workspace:*",
    "@tamagui/animate-presence": "catalog:",
    "@tamagui/core": "catalog:",
    "@tamagui/helpers": "catalog:",
    "@tamagui/linear-gradient": "catalog:",
    "@tamagui/stacks": "catalog:",
    "@tamagui/text": "catalog:",
    "@tamagui/use-controllable-state": "catalog:",
    "@tamagui/web": "catalog:",
    "react-native-svg": "^15.15.5"
  },
  "devDependencies": {
    "@storybook/react-vite": "catalog:",
    "@tamagui/avatar": "catalog:",
    "@tanstack/react-table": "^8.21.3",
    "@tanstack/table-core": "^8.21.3",
    "react": "catalog:",
    "react-dom": "catalog:",
    "react-native": "catalog:"
  },
  "publishConfig": {
    "access": "public"
  },
  "sideEffects": ["*.css"],
  "module:jsx": "dist/jsx",
  "main": "./dist/index.cjs",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.cts",
  "exports": {
    ".": {
      "import": "./dist/index.mjs",
      "require": "./dist/index.cjs"
    },
    "./Table": {
      "import": "./dist/Table.mjs",
      "require": "./dist/Table.cjs"
    },
    "./*": "./*"
  }
}
