{
  "name": "@cyclone-ui/privacy-choices",
  "version": "0.0.27",
  "type": "module",
  "description": "A \"Your Privacy Choices\" link, marked with the California privacy options icon, that opens a Dialog where users review their privacy rights and turn categories of cookies or data sharing on or off. Categories are listed in vertical Tabs with a Switch each, and required ones are shown as always active. Choices stay a draft until the user confirms them or rejects all but the necessary ones, then `onValueChange` receives every category's choice. Use it in a site footer.",
  "repository": {
    "type": "github",
    "url": "https://github.com/storm-software/cyclone-ui.git",
    "directory": "components/privacy-choices"
  },
  "private": false,
  "files": [
    "dist"
  ],
  "peerDependencies": {
    "react": "catalog:",
    "react-dom": "catalog:",
    "react-native": "catalog:"
  },
  "dependencies": {
    "@cyclone-ui/body-text": "workspace:*",
    "@cyclone-ui/button": "workspace:*",
    "@cyclone-ui/dialog": "workspace:*",
    "@cyclone-ui/heading-text": "workspace:*",
    "@cyclone-ui/icons": "workspace:*",
    "@cyclone-ui/scroll-view": "workspace:*",
    "@cyclone-ui/switch": "workspace:*",
    "@cyclone-ui/tabs": "workspace:*",
    "@tamagui/core": "catalog:",
    "@tamagui/use-controllable-state": "catalog:",
    "react-native-svg": "catalog:"
  },
  "devDependencies": {
    "@storybook/react-vite": "catalog:",
    "react": "catalog:",
    "react-dom": "catalog:",
    "react-native": "catalog:"
  },
  "publishConfig": {
    "access": "public"
  },
  "sideEffects": [
    "*.css"
  ],
  "module:jsx": "dist/jsx",
  "main": "./dist/index.cjs",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.cts",
  "exports": {
    ".": {
      "import": "./dist/index.mjs",
      "require": "./dist/index.cjs"
    },
    "./PrivacyChoices": {
      "import": "./dist/PrivacyChoices.mjs",
      "require": "./dist/PrivacyChoices.cjs"
    },
    "./*": "./*"
  }
}
