{
  "name": "@cyclone-ui/page",
  "version": "0.0.3",
  "type": "module",
  "description": "A base page layout compound component (banner, top nav, side nav, main and panel) for Cyclone UI applications",
  "repository": {
    "type": "github",
    "url": "https://github.com/storm-software/cyclone-ui.git",
    "directory": "components/page"
  },
  "private": false,
  "files": [
    "dist"
  ],
  "peerDependencies": {
    "react": "catalog:",
    "react-dom": "catalog:",
    "react-native": "catalog:"
  },
  "dependencies": {
    "@cyclone-ui/body-text": "workspace:*",
    "@cyclone-ui/icons": "workspace:*",
    "@cyclone-ui/scroll-view": "workspace:*",
    "@tamagui/animate-presence": "catalog:",
    "@tamagui/constants": "catalog:",
    "@tamagui/core": "catalog:"
  },
  "devDependencies": {
    "@cyclone-ui/button": "workspace:*",
    "@cyclone-ui/heading-text": "workspace:*",
    "@storybook/react-vite": "catalog:",
    "react": "catalog:",
    "react-dom": "catalog:",
    "react-native": "catalog:"
  },
  "publishConfig": {
    "access": "public"
  },
  "sideEffects": [
    "*.css"
  ],
  "main": "./dist/index.cjs",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.cts",
  "exports": {
    ".": {
      "import": "./dist/index.mjs",
      "require": "./dist/index.cjs"
    },
    "./Page": {
      "import": "./dist/Page.mjs",
      "require": "./dist/Page.cjs"
    },
    "./utilities": {
      "import": "./dist/utilities.mjs",
      "require": "./dist/utilities.cjs"
    },
    "./*": "./*"
  }
}
