{
  "name": "@cyclone-ui/date-picker-field",
  "version": "0.5.11",
  "type": "module",
  "description": "A form field for entering dates, made of a masked text input and a calendar trigger, with Label, Control, Details, Link and Icon subcomponents. It supports single and range modes, dot or slash separators, sizes, and floating or underline variants, and formats and parses values for form state.",
  "repository": {
    "type": "github",
    "url": "https://github.com/storm-software/cyclone-ui.git",
    "directory": "components/date-picker-field"
  },
  "private": false,
  "files": [
    "dist"
  ],
  "peerDependencies": {
    "react": "catalog:",
    "react-dom": "catalog:",
    "react-native": "catalog:"
  },
  "dependencies": {
    "@maskito/core": "catalog:",
    "@maskito/kit": "^3.11.1",
    "@stryke/date": "catalog:",
    "@tamagui/core": "catalog:",
    "@cyclone-ui/icons": "workspace:*",
    "react-native-svg": "^15.15.5",
    "@cyclone-ui/date-picker": "workspace:*",
    "@cyclone-ui/field": "workspace:*",
    "@cyclone-ui/helpers": "workspace:*",
    "@cyclone-ui/state": "workspace:*"
  },
  "devDependencies": {
    "@cyclone-ui/form": "workspace:*",
    "@storybook/react-vite": "catalog:",
    "react": "catalog:",
    "react-dom": "catalog:",
    "react-native": "catalog:"
  },
  "publishConfig": {
    "access": "public"
  },
  "sideEffects": [
    "*.css"
  ],
  "module:jsx": "dist/jsx",
  "main": "./dist/index.cjs",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.cts",
  "exports": {
    ".": {
      "import": "./dist/index.mjs",
      "require": "./dist/index.cjs"
    },
    "./DatePickerField": {
      "import": "./dist/DatePickerField.mjs",
      "require": "./dist/DatePickerField.cjs"
    },
    "./*": "./*"
  }
}
