{
  "name": "@cyclone-ui/text-area",
  "version": "0.1.11",
  "type": "module",
  "description": "A multiline text input that renders a textarea with 3 rows by default and uses the same tokens as the Cyclone UI Input. It has default, floating and underline variants, sm, md and lg sizes, and focus and disabled states, and its border reflects field validation messages.",
  "repository": {
    "type": "github",
    "url": "https://github.com/storm-software/cyclone-ui.git",
    "directory": "components/text-area"
  },
  "private": false,
  "files": [
    "dist"
  ],
  "dependencies": {
    "@cyclone-ui/field": "workspace:*",
    "@cyclone-ui/input": "workspace:*",
    "@tamagui/core": "catalog:",
    "@cyclone-ui/helpers": "workspace:*"
  },
  "peerDependencies": {
    "react": "catalog:",
    "react-dom": "catalog:",
    "react-native": "catalog:"
  },
  "devDependencies": {
    "@storybook/react-vite": "catalog:",
    "react": "catalog:",
    "react-dom": "catalog:",
    "react-native": "catalog:"
  },
  "publishConfig": {
    "access": "public"
  },
  "sideEffects": [
    "*.css"
  ],
  "module:jsx": "dist/jsx",
  "main": "./dist/index.cjs",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.cts",
  "exports": {
    ".": {
      "import": "./dist/index.mjs",
      "require": "./dist/index.cjs"
    },
    "./TextArea": {
      "import": "./dist/TextArea.mjs",
      "require": "./dist/TextArea.cjs"
    },
    "./*": "./*"
  }
}
