{
  "name": "@cyclone-ui/terminal",
  "version": "0.0.1",
  "type": "module",
  "description": "Terminal, the Cyclone UI AI component for a shell command the agent runs: a Trace line (\"Running pnpm build\", \"Ran pnpm build\", or \"pnpm lint exited with code 1\" in the danger color) that opens once output streams in, with the output in a code-font block that scrolls to the end as it grows. It takes `output`, `isStreaming`, `command`, `exitCode`, `autoScroll` and `onClear`, with copy and clear buttons beside the line.",
  "repository": {
    "type": "github",
    "url": "https://github.com/storm-software/cyclone-ui.git",
    "directory": "components/terminal"
  },
  "private": false,
  "files": [
    "dist"
  ],
  "peerDependencies": {
    "react": "catalog:",
    "react-dom": "catalog:",
    "react-native": "catalog:"
  },
  "dependencies": {
    "@cyclone-ui/button": "workspace:*",
    "@cyclone-ui/code-block": "workspace:*",
    "@cyclone-ui/copy-button": "workspace:*",
    "@cyclone-ui/icons": "workspace:*",
    "@cyclone-ui/trace": "workspace:*",
    "@tamagui/core": "catalog:"
  },
  "devDependencies": {
    "@storybook/react-vite": "catalog:",
    "react": "catalog:",
    "react-dom": "catalog:",
    "react-native": "catalog:"
  },
  "publishConfig": {
    "access": "public"
  },
  "sideEffects": false,
  "main": "./dist/index.cjs",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.cts",
  "exports": {
    ".": {
      "import": "./dist/index.mjs",
      "require": "./dist/index.cjs"
    },
    "./Terminal": {
      "import": "./dist/Terminal.mjs",
      "require": "./dist/Terminal.cjs"
    },
    "./*": "./*"
  }
}
