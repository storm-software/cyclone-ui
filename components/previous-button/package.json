{
  "name": "@cyclone-ui/previous-button",
  "version": "0.5.11",
  "type": "module",
  "description": "A button with an animated left-arrow icon and a default \"Previous\" label. The label can be hidden with hideText, and the arrow can shrink when animateShrink is set. Use it for back navigation in wizards, steppers and paginated flows.",
  "repository": {
    "type": "github",
    "url": "https://github.com/storm-software/cyclone-ui.git",
    "directory": "components/previous-button"
  },
  "private": false,
  "files": ["dist"],
  "peerDependencies": {
    "react": "catalog:",
    "react-dom": "catalog:",
    "react-native": "catalog:"
  },
  "dependencies": {
    "@stryke/hooks": "catalog:",
    "@tamagui/core": "catalog:",
    "@tamagui/stacks": "catalog:",
    "@cyclone-ui/button": "workspace:*",
    "@cyclone-ui/vectors": "workspace:*"
  },
  "devDependencies": {
    "@storybook/react-vite": "catalog:",
    "react": "catalog:",
    "react-dom": "catalog:",
    "react-native": "catalog:"
  },
  "publishConfig": {
    "access": "public"
  },
  "sideEffects": ["*.css"],
  "module:jsx": "dist/jsx",
  "main": "./dist/index.cjs",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.cts",
  "exports": {
    ".": {
      "import": "./dist/index.mjs",
      "require": "./dist/index.cjs"
    },
    "./PreviousButton": {
      "import": "./dist/PreviousButton.mjs",
      "require": "./dist/PreviousButton.cjs"
    },
    "./*": "./*"
  }
}
