{
  "name": "@cyclone-ui/navigation-header",
  "version": "0.0.1",
  "type": "module",
  "description": "A repository containing the core front-end components used by Storm Software across many platforms",
  "repository": {
    "type": "github",
    "url": "https://github.com/storm-software/cyclone-ui.git",
    "directory": "components/navigation-header"
  },
  "private": false,
  "files": ["dist"],
  "peerDependencies": {
    "react": "catalog:",
    "react-dom": "catalog:",
    "react-native": "catalog:"
  },
  "dependencies": {
    "@cyclone-ui/link": "workspace:*",
    "@tamagui/core": "catalog:",
    "@tamagui/lucide-icons-2": "catalog:"
  },
  "devDependencies": {
    "@cyclone-ui/button": "workspace:*",
    "@storybook/react-vite": "catalog:",
    "@tamagui/text": "catalog:",
    "react": "catalog:",
    "react-dom": "catalog:",
    "react-native": "catalog:"
  },
  "publishConfig": {
    "access": "public"
  },
  "sideEffects": ["*.css"],
  "main": "./dist/index.cjs",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.cts",
  "exports": {
    ".": {
      "import": "./dist/index.mjs",
      "require": "./dist/index.cjs"
    },
    "./NavigationHeader": {
      "import": "./dist/NavigationHeader.mjs",
      "require": "./dist/NavigationHeader.cjs"
    },
    "./*": "./*"
  }
}
