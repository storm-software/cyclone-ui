{
  "name": "@cyclone-ui/data-table",
  "version": "0.6.1",
  "type": "module",
  "description": "A repository containing the core front-end components used by Storm Software across many platforms",
  "repository": {
    "type": "github",
    "url": "https://github.com/storm-software/cyclone-ui.git",
    "directory": "components/data-table"
  },
  "private": false,
  "files": ["dist"],
  "peerDependencies": {
    "react": "catalog:",
    "react-dom": "catalog:",
    "react-native": "catalog:"
  },
  "dependencies": {
    "@stryke/helpers": "catalog:",
    "@stryke/string-format": "catalog:",
    "@stryke/type-checks": "catalog:",
    "@stryke/types": "catalog:",
    "@tamagui/adapt": "catalog:",
    "@tamagui/animate-presence": "catalog:",
    "@tamagui/core": "catalog:",
    "@tamagui/helpers": "catalog:",
    "@tamagui/lucide-icons-2": "catalog:",
    "@tamagui/stacks": "catalog:",
    "@tamagui/text": "catalog:",
    "@tanstack/react-table": "^8.21.3",
    "@tanstack/table-core": "^8.21.3",
    "@cyclone-ui/button": "workspace:*",
    "@cyclone-ui/checkbox-field": "workspace:*",
    "@cyclone-ui/form": "workspace:*",
    "@cyclone-ui/label-text": "workspace:*",
    "@cyclone-ui/pagination": "workspace:*",
    "@cyclone-ui/popover": "workspace:*",
    "@cyclone-ui/search-input-field": "workspace:*",
    "@cyclone-ui/select-field": "workspace:*",
    "@cyclone-ui/state": "workspace:*",
    "@cyclone-ui/table": "workspace:*"
  },
  "devDependencies": {
    "@storybook/react-vite": "catalog:",
    "@tamagui/avatar": "catalog:",
    "react": "catalog:",
    "react-dom": "catalog:",
    "react-native": "catalog:"
  },
  "publishConfig": {
    "access": "public"
  },
  "sideEffects": ["*.css"],
  "module:jsx": "dist/jsx",
  "main": "./dist/index.cjs",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.cts",
  "exports": {
    ".": {
      "import": "./dist/index.mjs",
      "require": "./dist/index.cjs"
    },
    "./DataTable": {
      "import": "./dist/DataTable.mjs",
      "require": "./dist/DataTable.cjs"
    },
    "./*": "./*"
  }
}
