{
  "name": "@cyclone-ui/data-table",
  "version": "0.6.28",
  "private": false,
  "description": "A data grid built on TanStack Table and the Cyclone UI Table that takes table options (columns and data) and adds sorting, faceted column filtering, client-side pagination with a configurable page size, optional row selection checkboxes and resizable columns. Use it to display large, interactive datasets.",
  "repository": {
    "type": "github",
    "url": "https://github.com/storm-software/cyclone-ui.git",
    "directory": "components/data-table"
  },
  "sideEffects": [
    "*.css"
  ],
  "type": "module",
  "exports": {
    ".": {
      "import": "./dist/index.mjs",
      "require": "./dist/index.cjs"
    },
    "./DataTable": {
      "import": "./dist/DataTable.mjs",
      "require": "./dist/DataTable.cjs"
    },
    "./*": "./*"
  },
  "main": "./dist/index.cjs",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.cts",
  "files": [
    "dist"
  ],
  "dependencies": {
    "@cyclone-ui/body-text": "workspace:*",
    "@cyclone-ui/button": "workspace:*",
    "@cyclone-ui/checkbox": "workspace:*",
    "@cyclone-ui/context-menu": "workspace:*",
    "@cyclone-ui/field": "workspace:*",
    "@cyclone-ui/form": "workspace:*",
    "@cyclone-ui/heading-text": "workspace:*",
    "@cyclone-ui/icons": "workspace:*",
    "@cyclone-ui/pagination": "workspace:*",
    "@cyclone-ui/popover": "workspace:*",
    "@cyclone-ui/search-input": "workspace:*",
    "@cyclone-ui/select": "workspace:*",
    "@cyclone-ui/state": "workspace:*",
    "@cyclone-ui/table": "workspace:*",
    "@stryke/helpers": "catalog:",
    "@stryke/string-format": "catalog:",
    "@stryke/type-checks": "catalog:",
    "@stryke/types": "catalog:",
    "@tamagui/adapt": "catalog:",
    "@tamagui/animate-presence": "catalog:",
    "@tamagui/core": "catalog:",
    "@tamagui/helpers": "catalog:",
    "@tamagui/stacks": "catalog:",
    "@tamagui/text": "catalog:",
    "@tanstack/react-table": "^8.21.3",
    "@tanstack/react-virtual": "catalog:",
    "@tanstack/table-core": "^8.21.3"
  },
  "devDependencies": {
    "@storybook/react-vite": "catalog:",
    "@tamagui/avatar": "catalog:",
    "react": "catalog:",
    "react-dom": "catalog:",
    "react-native": "catalog:"
  },
  "peerDependencies": {
    "react": "catalog:",
    "react-dom": "catalog:",
    "react-native": "catalog:"
  },
  "publishConfig": {
    "access": "public"
  },
  "module:jsx": "dist/jsx"
}
