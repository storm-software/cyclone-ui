{
  "name": "@cyclone-ui/themeable-icon",
  "version": "0.6.11",
  "type": "module",
  "description": "An icon wrapper that applies size and color tokens to its child icon and animates when it enters or exits. It includes ThemedIcon and a getIconByTheme helper that pick a matching status icon (danger, warning, info, discovery, success, positive, negative) or a lock icon when disabled. Use it for status icons that follow the current theme.",
  "repository": {
    "type": "github",
    "url": "https://github.com/storm-software/cyclone-ui.git",
    "directory": "components/themeable-icon"
  },
  "private": false,
  "files": [
    "dist"
  ],
  "peerDependencies": {
    "react": "catalog:",
    "react-dom": "catalog:",
    "react-native": "catalog:"
  },
  "dependencies": {
    "@tamagui/core": "catalog:",
    "@tamagui/font-size": "catalog:",
    "@tamagui/get-token": "catalog:",
    "@tamagui/helpers": "catalog:",
    "@tamagui/helpers-icon": "catalog:",
    "@tamagui/helpers-tamagui": "catalog:",
    "@cyclone-ui/icons": "workspace:*",
    "@tamagui/web": "catalog:",
    "react-native-svg": "^15.15.5",
    "@cyclone-ui/helpers": "workspace:*",
    "@cyclone-ui/vectors": "workspace:*"
  },
  "devDependencies": {
    "@storybook/react-vite": "catalog:",
    "react": "catalog:",
    "react-dom": "catalog:",
    "react-native": "catalog:"
  },
  "publishConfig": {
    "access": "public"
  },
  "sideEffects": [
    "*.css"
  ],
  "module:jsx": "dist/jsx",
  "main": "./dist/index.cjs",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.cts",
  "exports": {
    ".": {
      "import": "./dist/index.mjs",
      "require": "./dist/index.cjs"
    },
    "./ThemeableIcon": {
      "import": "./dist/ThemeableIcon.mjs",
      "require": "./dist/ThemeableIcon.cjs"
    },
    "./*": "./*"
  }
}
