{
  "name": "@cyclone-ui/themeable-icon",
  "version": "0.6.1",
  "type": "module",
  "description": "A repository containing the core front-end components used by Storm Software across many platforms",
  "repository": {
    "type": "github",
    "url": "https://github.com/storm-software/cyclone-ui.git",
    "directory": "components/themeable-icon"
  },
  "private": false,
  "files": ["dist"],
  "peerDependencies": {
    "react": "catalog:",
    "react-dom": "catalog:",
    "react-native": "catalog:"
  },
  "dependencies": {
    "@tamagui/core": "catalog:",
    "@tamagui/font-size": "catalog:",
    "@tamagui/get-token": "catalog:",
    "@tamagui/helpers": "catalog:",
    "@tamagui/helpers-icon": "catalog:",
    "@tamagui/helpers-tamagui": "catalog:",
    "@tamagui/lucide-icons-2": "catalog:",
    "@tamagui/web": "catalog:",
    "react-native-svg": "^15.15.5",
    "@cyclone-ui/helpers": "workspace:*",
    "@cyclone-ui/vectors": "workspace:*"
  },
  "devDependencies": {
    "@storybook/react-vite": "catalog:",
    "react": "catalog:",
    "react-dom": "catalog:",
    "react-native": "catalog:"
  },
  "publishConfig": {
    "access": "public"
  },
  "sideEffects": ["*.css"],
  "module:jsx": "dist/jsx",
  "main": "./dist/index.cjs",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.cts",
  "exports": {
    ".": {
      "import": "./dist/index.mjs",
      "require": "./dist/index.cjs"
    },
    "./ThemeableIcon": {
      "import": "./dist/ThemeableIcon.mjs",
      "require": "./dist/ThemeableIcon.cjs"
    },
    "./*": "./*"
  }
}
