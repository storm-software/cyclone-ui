{
  "name": "@cyclone-ui/checkpoint",
  "version": "0.0.1",
  "type": "module",
  "description": "Checkpoint, a point in an AI conversation that the person can return to: a separator after a turn that shows a decorative Checkpoint.Icon (a restore clock by default), a label and a Checkpoint.Trigger button (Restore by default, with an optional tooltip) between two rules. The border variant puts a rule under the row instead and the inline variant drops the rules. Restoring keeps that turn and drops every message after it.",
  "repository": {
    "type": "github",
    "url": "https://github.com/storm-software/cyclone-ui.git",
    "directory": "components/checkpoint"
  },
  "private": false,
  "files": [
    "dist"
  ],
  "peerDependencies": {
    "react": "catalog:",
    "react-dom": "catalog:",
    "react-native": "catalog:"
  },
  "dependencies": {
    "@cyclone-ui/body-text": "workspace:*",
    "@cyclone-ui/button": "workspace:*",
    "@cyclone-ui/divider": "workspace:*",
    "@cyclone-ui/icons": "workspace:*",
    "@tamagui/core": "catalog:",
    "@tamagui/helpers-tamagui": "catalog:"
  },
  "devDependencies": {
    "@cyclone-ui/prompt-message": "workspace:*",
    "@storybook/react-vite": "catalog:",
    "react": "catalog:",
    "react-dom": "catalog:",
    "react-native": "catalog:"
  },
  "publishConfig": {
    "access": "public"
  },
  "sideEffects": false,
  "main": "./dist/index.cjs",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.cts",
  "exports": {
    ".": {
      "import": "./dist/index.mjs",
      "require": "./dist/index.cjs"
    },
    "./Checkpoint": {
      "import": "./dist/Checkpoint.mjs",
      "require": "./dist/Checkpoint.cjs"
    },
    "./*": "./*"
  }
}
