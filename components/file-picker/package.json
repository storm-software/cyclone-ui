      "require": "./dist/cjs/index.js",
      "react-native": "./dist/cjs/index.native.js"
    }
  },
  "types": "./types/index.d.ts",
  "files": [
    "dist",
    "src",
    "types"
  ],
  "peerDependencies": {
    "react": "catalog:",
    "react-dom": "catalog:",
    "react-native": "catalog:"
  },
  "dependencies": {
    "@stryke/date": "catalog:",
    "@stryke/hooks": "catalog:",
    "@stryke/types": "catalog:",
    "@tamagui/animate-presence": "catalog:",
    "@tamagui/constants": "catalog:",
    "@tamagui/core": "catalog:",
    "@tamagui/group": "catalog:",
    "@tamagui/helpers": "catalog:",
    "@tamagui/helpers-tamagui": "catalog:",
    "@tamagui/image": "catalog:",
    "@tamagui/linear-gradient": "catalog:",
    "@tamagui/lucide-icons": "catalog:",
    "@tamagui/separator": "catalog:",
