    "@tamagui/text": "catalog:",
    "@tamagui/web": "catalog:",
    "expo-document-picker": "catalog:",
    "expo-image-picker": "^15.1.0",
    "react-dropzone": "^14.4.1",
    "react-native-svg": "^15.15.5"
  },
  "devDependencies": {
    "@cyclone-ui/field": "workspace:*",
    "@cyclone-ui/form": "workspace:*",
