{
  "name": "@cyclone-ui/chart",
  "version": "0.0.5",
  "type": "module",
  "description": "Shared building blocks for the Cyclone UI chart packages, built on Recharts. It provides the chart container, which maps each series to theme data colors, and the tooltip, legend, point markers, zoom brush, background patterns, reveal animation and loading skeleton that the charts reuse. Use it to build a custom Recharts chart that looks like the other Cyclone charts.",
  "repository": {
    "type": "github",
    "url": "https://github.com/storm-software/cyclone-ui.git",
    "directory": "components/chart"
  },
  "private": false,
  "files": [
    "dist"
  ],
  "peerDependencies": {
    "react": "catalog:",
    "react-dom": "catalog:",
    "react-native": "catalog:"
  },
  "dependencies": {
    "@cyclone-ui/body-text": "workspace:*",
    "@cyclone-ui/number-text": "workspace:*",
    "@cyclone-ui/spinner": "workspace:*",
    "@tamagui/core": "catalog:",
    "@tamagui/stacks": "catalog:",
    "motion": "catalog:",
    "recharts": "catalog:"
  },
  "devDependencies": {
    "@storybook/react-vite": "catalog:",
    "react": "catalog:",
    "react-dom": "catalog:",
    "react-native": "catalog:"
  },
  "publishConfig": {
    "access": "public"
  },
  "sideEffects": [
    "*.css"
  ],
  "module:jsx": "dist/jsx",
  "main": "./dist/index.cjs",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.cts",
  "exports": {
    ".": {
      "import": "./dist/index.mjs",
      "require": "./dist/index.cjs"
    },
    "./Chart": {
      "import": "./dist/Chart.mjs",
      "require": "./dist/Chart.cjs"
    },
    "./ChartBackground": {
      "import": "./dist/ChartBackground.mjs",
      "require": "./dist/ChartBackground.cjs"
    },
    "./ChartBrush": {
      "import": "./dist/ChartBrush.mjs",
      "require": "./dist/ChartBrush.cjs"
    },
    "./ChartDot": {
      "import": "./dist/ChartDot.mjs",
      "require": "./dist/ChartDot.cjs"
    },
    "./ChartLegend": {
      "import": "./dist/ChartLegend.mjs",
      "require": "./dist/ChartLegend.cjs"
    },
    "./ChartTooltip": {
      "import": "./dist/ChartTooltip.mjs",
      "require": "./dist/ChartTooltip.cjs"
    },
    "./utilities": {
      "import": "./dist/utilities.mjs",
      "require": "./dist/utilities.cjs"
    },
    "./*": "./*"
  }
}
