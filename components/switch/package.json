{
  "name": "@cyclone-ui/switch",
  "version": "0.5.11",
  "type": "module",
  "description": "A toggle switch with an animated thumb, sm, md and lg sizes, and a disabled state. Its border reflects field validation messages, and Switch.Icon places an icon on the left or right of the track. Use it for on/off settings inside or outside a form field.",
  "repository": {
    "type": "github",
    "url": "https://github.com/storm-software/cyclone-ui.git",
    "directory": "components/switch"
  },
  "private": false,
  "peerDependencies": {
    "react": "catalog:",
    "react-dom": "catalog:",
    "react-native": "catalog:"
  },
  "dependencies": {
    "@tamagui/constants": "catalog:",
    "@tamagui/core": "catalog:",
    "@tamagui/create-context": "catalog:",
    "@tamagui/get-token": "catalog:",
    "@tamagui/group": "catalog:",
    "@tamagui/stacks": "catalog:",
    "@tamagui/switch": "catalog:",
    "@tamagui/switch-headless": "catalog:",
    "@cyclone-ui/helpers": "workspace:*",
    "@cyclone-ui/themeable-icon": "workspace:*",
    "@tamagui/react-native-types": "catalog:"
  },
  "devDependencies": {
    "@cyclone-ui/field": "workspace:*",
    "@cyclone-ui/form": "workspace:*",
    "@storybook/react-vite": "catalog:",
    "react": "catalog:",
    "react-dom": "catalog:",
    "react-native": "catalog:"
  },
  "publishConfig": {
    "access": "public"
  },
  "source": "src/index.ts",
  "main": "./dist/index.cjs",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.cts",
  "exports": {
    ".": {
      "import": "./dist/index.mjs",
      "require": "./dist/index.cjs"
    },
    "./Switch": {
      "import": "./dist/Switch.mjs",
      "require": "./dist/Switch.cjs"
    },
    "./*": "./*"
  }
}
