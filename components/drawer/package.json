{
  "name": "@cyclone-ui/drawer",
  "version": "0.1.39",
  "type": "module",
  "description": "A side panel built on the Cyclone UI Sheet that slides in from the right by default and comes in sm, md and lg sizes. It has Frame, Handle, Overlay, ScrollView, Header (with optional back and close buttons), Title, Description, Heading, Body and Footer parts; the Footer stays visible while content scrolls. Use it for navigation, filters or secondary content shown beside the main view.",
  "repository": {
    "type": "github",
    "url": "https://github.com/storm-software/cyclone-ui.git",
    "directory": "components/drawer"
  },
  "private": false,
  "files": [
    "dist"
  ],
  "peerDependencies": {
    "react": "catalog:",
    "react-dom": "catalog:",
    "react-native": "catalog:"
  },
  "dependencies": {
    "@cyclone-ui/body-text": "workspace:*",
    "@cyclone-ui/button": "workspace:*",
    "@cyclone-ui/heading-text": "workspace:*",
    "@cyclone-ui/icons": "workspace:*",
    "@cyclone-ui/scroll-view": "workspace:*",
    "@cyclone-ui/sheet": "workspace:*",
    "@tamagui/core": "catalog:",
    "@tamagui/dialog": "catalog:",
    "@tamagui/helpers": "catalog:",
    "@tamagui/sheet": "catalog:",
    "@tamagui/stacks": "catalog:"
  },
  "devDependencies": {
    "@storybook/react-vite": "catalog:",
    "react": "catalog:",
    "react-dom": "catalog:",
    "react-native": "catalog:"
  },
  "publishConfig": {
    "access": "public"
  },
  "sideEffects": [
    "*.css"
  ],
  "module:jsx": "dist/jsx",
  "main": "./dist/index.cjs",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.cts",
  "exports": {
    ".": {
      "import": "./dist/index.mjs",
      "require": "./dist/index.cjs"
    },
    "./Drawer": {
      "import": "./dist/Drawer.mjs",
      "require": "./dist/Drawer.cjs"
    },
    "./*": "./*"
  }
}
