{
  "name": "@cyclone-ui/tabs",
  "version": "0.3.65",
  "type": "module",
  "description": "A tabbed interface with Header.Item triggers and Content.Item panels. It offers underline, floating, tabbed and fluid (gooey WebGL pill) tab styles in horizontal or vertical orientation, optional borders and sizes, and an animated active indicator. The floating style's indicator pill is a Container that takes the Container variants (primary, secondary, tertiary, outlined, sunken, canvas, surface, elevated, floating) and its shadow, glass, noise and accented options, and the fluid pill takes the variant's color. onValueChange reports the selected tab.",
  "repository": {
    "type": "github",
    "url": "https://github.com/storm-software/cyclone-ui.git",
    "directory": "components/tabs"
  },
  "private": false,
  "files": [
    "dist"
  ],
  "peerDependencies": {
    "react": "catalog:",
    "react-dom": "catalog:",
    "react-native": "catalog:"
  },
  "dependencies": {
    "@cyclone-ui/container": "workspace:*",
    "@cyclone-ui/heading-text": "workspace:*",
    "@cyclone-ui/helpers": "workspace:*",
    "@tamagui/animate-presence": "catalog:",
    "@tamagui/constants": "catalog:",
    "@tamagui/core": "catalog:",
    "@tamagui/get-font-sized": "catalog:",
    "@tamagui/stacks": "catalog:",
    "@tamagui/tabs": "catalog:",
    "react-native-svg": "catalog:"
  },
  "devDependencies": {
    "@cyclone-ui/body-text": "workspace:*",
    "@storybook/react-vite": "catalog:",
    "react": "catalog:",
    "react-dom": "catalog:",
    "react-native": "catalog:"
  },
  "publishConfig": {
    "access": "public"
  },
  "sideEffects": [
    "*.css"
  ],
  "module:jsx": "dist/jsx",
  "main": "./dist/index.cjs",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.cts",
  "exports": {
    ".": {
      "import": "./dist/index.mjs",
      "require": "./dist/index.cjs"
    },
    "./fluid": {
      "import": "./dist/fluid.mjs",
      "require": "./dist/fluid.cjs"
    },
    "./Tabs": {
      "import": "./dist/Tabs.mjs",
      "require": "./dist/Tabs.cjs"
    },
    "./*": "./*"
  }
}
