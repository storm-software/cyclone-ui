{
  "name": "@cyclone-ui/tag-picker",
  "version": "0.0.6",
  "type": "module",
  "description": "A TagPicker input that turns typed text into removable tags. Enter adds a trimmed, unique tag, Backspace removes the last tag, and each tag has an accessible remove button. It can be controlled or uncontrolled (value, defaultValue, onChange) and supports size, variant, tagVariant and disabled props, plus validation styling. The package also exports tag list helpers. Use it for free-form keyword or label entry.",
  "repository": {
    "type": "github",
    "url": "https://github.com/storm-software/cyclone-ui.git",
    "directory": "components/tag-picker"
  },
  "private": false,
  "files": [
    "dist"
  ],
  "peerDependencies": {
    "react": "catalog:",
    "react-dom": "catalog:",
    "react-native": "catalog:"
  },
  "dependencies": {
    "@cyclone-ui/field": "workspace:*",
    "@cyclone-ui/helpers": "workspace:*",
    "@cyclone-ui/input": "workspace:*",
    "@cyclone-ui/tag": "workspace:*",
    "@tamagui/animate-presence": "catalog:",
    "@tamagui/core": "catalog:",
    "@tamagui/stacks": "catalog:"
  },
  "devDependencies": {
    "@storybook/react-vite": "catalog:",
    "react": "catalog:",
    "react-dom": "catalog:",
    "react-native": "catalog:"
  },
  "publishConfig": {
    "access": "public"
  },
  "sideEffects": [
    "*.css"
  ],
  "module:jsx": "dist/jsx",
  "main": "./dist/index.cjs",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.cts",
  "exports": {
    ".": {
      "import": "./dist/index.mjs",
      "require": "./dist/index.cjs"
    },
    "./TagPicker": {
      "import": "./dist/TagPicker.mjs",
      "require": "./dist/TagPicker.cjs"
    },
    "./utilities": {
      "import": "./dist/utilities.mjs",
      "require": "./dist/utilities.cjs"
    },
    "./*": "./*"
  }
}
