{
  "name": "@cyclone-ui/composed-chart",
  "version": "0.0.2",
  "type": "module",
  "description": "A composable chart that draws bars and lines on the same axes, built on Recharts and the shared Cyclone chart parts. Bars and lines keep the fill, stroke, glow and point marker styles of the bar and line charts. It also supports a zoom brush, legend selection and a loading skeleton. Use it to show a value next to a related trend, such as revenue bars with a growth line.",
  "repository": {
    "type": "github",
    "url": "https://github.com/storm-software/cyclone-ui.git",
    "directory": "components/composed-chart"
  },
  "private": false,
  "files": [
    "dist"
  ],
  "peerDependencies": {
    "react": "catalog:",
    "react-dom": "catalog:",
    "react-native": "catalog:"
  },
  "dependencies": {
    "@cyclone-ui/chart": "workspace:*",
    "motion": "catalog:",
    "recharts": "catalog:"
  },
  "devDependencies": {
    "@storybook/react-vite": "catalog:",
    "@tamagui/stacks": "catalog:",
    "react": "catalog:",
    "react-dom": "catalog:",
    "react-native": "catalog:"
  },
  "publishConfig": {
    "access": "public"
  },
  "sideEffects": [
    "*.css"
  ],
  "module:jsx": "dist/jsx",
  "main": "./dist/index.cjs",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.cts",
  "exports": {
    ".": {
      "import": "./dist/index.mjs",
      "require": "./dist/index.cjs"
    },
    "./ComposedChart": {
      "import": "./dist/ComposedChart.mjs",
      "require": "./dist/ComposedChart.cjs"
    },
    "./*": "./*"
  }
}
