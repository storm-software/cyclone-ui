{
  "name": "@cyclone-ui/file-tree",
  "version": "0.0.9",
  "type": "module",
  "description": "A FileTree component that renders a hierarchical file structure using File leaves and expandable Folder branches. Folders animate open and closed, can start open with defaultOpen, accept custom icons and openIcon, and can be toggled with Enter or Space. It uses ARIA tree and treeitem roles. Use it to show directory or project structures.",
  "repository": {
    "type": "github",
    "url": "https://github.com/storm-software/cyclone-ui.git",
    "directory": "components/file-tree"
  },
  "private": false,
  "files": [
    "dist"
  ],
  "peerDependencies": {
    "react": "catalog:",
    "react-dom": "catalog:",
    "react-native": "catalog:"
  },
  "dependencies": {
    "@tamagui/animate-presence": "catalog:",
    "@tamagui/core": "catalog:",
    "@cyclone-ui/icons": "workspace:*",
    "@tamagui/stacks": "catalog:",
    "@tamagui/text": "catalog:"
  },
  "devDependencies": {
    "@storybook/react-vite": "catalog:",
    "react": "catalog:",
    "react-dom": "catalog:",
    "react-native": "catalog:"
  },
  "publishConfig": {
    "access": "public"
  },
  "sideEffects": [
    "*.css"
  ],
  "main": "./dist/index.cjs",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.cts",
  "exports": {
    ".": {
      "import": "./dist/index.mjs",
      "require": "./dist/index.cjs"
    },
    "./FileTree": {
      "import": "./dist/FileTree.mjs",
      "require": "./dist/FileTree.cjs"
    },
    "./*": "./*"
  }
}
