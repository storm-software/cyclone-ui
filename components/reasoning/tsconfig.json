{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "tsBuildInfoFile": "../../dist/out-tsc/components/reasoning/tsconfig.tsbuildinfo",
    "jsx": "preserve",
    "lib": [
      "ESNext",
      "DOM"
    ],
    "ignoreDeprecations": "6.0",
    "rootDir": ".",
    "types": [
      "node",
      "@nx/react/typings/cssmodule.d.ts",
      "@nx/react/typings/image.d.ts"
    ],
    "outDir": "../../dist/out-tsc/components/reasoning"
  },
  "references": [
    {
      "path": "../../tools/config"
    },
    {
      "path": "../icons"
    },
    {
      "path": "../trace"
    }
  ],
  "files": [],
  "include": [
    "src/**/*.ts",
    "src/**/*.tsx"
  ],
  "exclude": [
    "vitest.config.mts",
    "src/**/*.spec.ts",
    "src/**/*.test.ts",
    "src/**/*.spec.tsx",
    "src/**/*.test.tsx"
  ]
}
