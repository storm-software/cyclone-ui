{
  "name": "@cyclone-ui/font-preview",
  "version": "0.0.8",
  "type": "module",
  "description": "A font specimen that shows each weight and style of a font from the Tamagui config as its own labeled row (such as Regular 400 or Black 900 Italic), in text the reader types and at a size chosen from a select of presets or with a slider. The rows default to the faces the font declares.",
  "repository": {
    "type": "github",
    "url": "https://github.com/storm-software/cyclone-ui.git",
    "directory": "components/font-preview"
  },
  "private": false,
  "files": [
    "dist"
  ],
  "peerDependencies": {
    "react": "catalog:",
    "react-dom": "catalog:",
    "react-native": "catalog:"
  },
  "dependencies": {
    "@cyclone-ui/body-text": "workspace:*",
    "@cyclone-ui/field": "workspace:*",
    "@cyclone-ui/form": "workspace:*",
    "@cyclone-ui/input": "workspace:*",
    "@cyclone-ui/select": "workspace:*",
    "@cyclone-ui/slider": "workspace:*",
    "@cyclone-ui/state": "workspace:*",
    "@tamagui/core": "catalog:",
    "@tamagui/stacks": "catalog:"
  },
  "devDependencies": {
    "@storybook/react-vite": "catalog:",
    "react": "catalog:",
    "react-dom": "catalog:",
    "react-native": "catalog:"
  },
  "publishConfig": {
    "access": "public"
  },
  "sideEffects": false,
  "main": "./dist/index.cjs",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.cts",
  "exports": {
    ".": {
      "import": "./dist/index.mjs",
      "require": "./dist/index.cjs"
    },
    "./FontPreview": {
      "import": "./dist/FontPreview.mjs",
      "require": "./dist/FontPreview.cjs"
    },
    "./*": "./*"
  }
}
