{
  "name": "@cyclone-ui/stepper",
  "version": "0.3.11",
  "type": "module",
  "description": "A multi-step wizard built on Tamagui Tabs with a vertical header list that marks completed and current steps with check icons, plus optional step numbers. Compound parts are Stepper.Header.Item, Stepper.Content.Item, Stepper.NextButton and Stepper.PreviousButton, and it tracks which steps have been visited. Use it for guided, ordered flows.",
  "repository": {
    "type": "github",
    "url": "https://github.com/storm-software/cyclone-ui.git",
    "directory": "components/stepper"
  },
  "private": false,
  "files": ["dist"],
  "peerDependencies": {
    "react": "catalog:",
    "react-dom": "catalog:",
    "react-native": "catalog:"
  },
  "dependencies": {
    "@cyclone-ui/heading-text": "workspace:*",
    "@cyclone-ui/next-button": "workspace:*",
    "@cyclone-ui/previous-button": "workspace:*",
    "@tamagui/animate-presence": "catalog:",
    "@tamagui/button": "catalog:",
    "@tamagui/core": "catalog:",
    "@tamagui/font-size": "catalog:",
    "@tamagui/get-font-sized": "catalog:",
    "@tamagui/helpers": "catalog:",
    "@tamagui/helpers-tamagui": "catalog:",
    "@tamagui/linear-gradient": "catalog:",
    "@cyclone-ui/icons": "workspace:*",
    "@tamagui/react-native-types": "catalog:",
    "@tamagui/shapes": "catalog:",
    "@tamagui/stacks": "catalog:",
    "@tamagui/tabs": "catalog:",
    "@tamagui/text": "catalog:",
    "@tamagui/use-controllable-state": "catalog:",
    "@tamagui/web": "catalog:",
    "react-native-svg": "^15.15.5"
  },
  "devDependencies": {
    "@storybook/react-vite": "catalog:",
    "react": "catalog:",
    "react-dom": "catalog:",
    "react-native": "catalog:"
  },
  "publishConfig": {
    "access": "public"
  },
  "sideEffects": ["*.css"],
  "module:jsx": "dist/jsx",
  "main": "./dist/index.cjs",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.cts",
  "exports": {
    ".": {
      "import": "./dist/index.mjs",
      "require": "./dist/index.cjs"
    },
    "./Stepper": {
      "import": "./dist/Stepper.mjs",
      "require": "./dist/Stepper.cjs"
    },
    "./*": "./*"
  }
}
