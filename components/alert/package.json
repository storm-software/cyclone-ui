{
  "name": "@cyclone-ui/alert",
  "version": "0.4.0",
  "type": "module",
  "description": "A package containing the Alert component used by Storm Software",
  "repository": {
    "type": "github",
    "url": "https://github.com/storm-software/cyclone-ui.git",
    "directory": "components/alert"
  },
  "private": false,
  "files": [
    "dist"
  ],
  "peerDependencies": {
    "react": "catalog:",
    "react-dom": "catalog:",
    "react-native": "catalog:"
  },
  "dependencies": {
    "@tamagui/core": "catalog:",
    "@tamagui/group": "catalog:",
    "@tamagui/helpers": "catalog:",
    "@tamagui/helpers-tamagui": "catalog:",
    "@tamagui/lucide-icons-2": "catalog:",
    "@tamagui/stacks": "catalog:",
    "@tamagui/text": "catalog:",
    "@tamagui/web": "catalog:",
    "@cyclone-ui/helpers": "workspace:*",
    "@cyclone-ui/themeable-icon": "workspace:*",
    "@cyclone-ui/body-text": "workspace:*",
    "@cyclone-ui/heading-text": "workspace:*",
    "@cyclone-ui/container": "workspace:*",
    "@cyclone-ui/button": "workspace:*"
  },
  "devDependencies": {
    "@storybook/react-vite": "catalog:",
    "react": "catalog:",
    "react-dom": "catalog:",
    "react-native": "catalog:"
  },
  "publishConfig": {
    "access": "public"
  },
  "sideEffects": [
    "*.css"
  ],
  "module:jsx": "dist/jsx",
  "main": "./dist/index.cjs",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.cts",
  "exports": {
    ".": {
      "import": "./dist/index.mjs",
      "require": "./dist/index.cjs"
    },
    "./Alert": {
      "import": "./dist/Alert.mjs",
      "require": "./dist/Alert.cjs"
    },
    "./*": "./*"
  }
}
