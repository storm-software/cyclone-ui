{
  "name": "@cyclone-ui/type-table",
  "version": "0.0.7",
  "type": "module",
  "description": "A documentation table that lists properties with their types. Each row expands to show the description, default, parameters and return value, and can link to a type description. Required and deprecated items are marked. Rows can be deep-linked through the URL hash.",
  "repository": {
    "type": "github",
    "url": "https://github.com/storm-software/cyclone-ui.git",
    "directory": "components/type-table"
  },
  "private": false,
  "files": ["dist"],
  "peerDependencies": {
    "react": "catalog:",
    "react-dom": "catalog:",
    "react-native": "catalog:"
  },
  "dependencies": {
    "@cyclone-ui/body-text": "workspace:*",
    "@cyclone-ui/collapsible": "workspace:*",
    "@cyclone-ui/container": "workspace:*",
    "@cyclone-ui/heading-text": "workspace:*",
    "@cyclone-ui/inline-code-text": "workspace:*",
    "@cyclone-ui/link": "workspace:*",
    "@tamagui/core": "catalog:"
  },
  "devDependencies": {
    "@storybook/react-vite": "catalog:",
    "@vitejs/plugin-react-swc": "catalog:",
    "react": "catalog:",
    "react-dom": "catalog:",
    "react-native": "catalog:"
  },
  "publishConfig": {
    "access": "public"
  },
  "sideEffects": ["*.css"],
  "module:jsx": "dist/jsx",
  "source": "src/index.ts",
  "main": "./dist/index.cjs",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.cts",
  "exports": {
    ".": {
      "import": "./dist/index.mjs",
      "require": "./dist/index.cjs"
    },
    "./TypeTable": {
      "import": "./dist/TypeTable.mjs",
      "require": "./dist/TypeTable.cjs"
    },
    "./TypeTableItemDetails": {
      "import": "./dist/TypeTableItemDetails.mjs",
      "require": "./dist/TypeTableItemDetails.cjs"
    },
    "./*": "./*"
  }
}
