{
  "name": "@cyclone-ui/date-picker",
  "version": "0.5.55",
  "type": "module",
  "description": "A date input with a masked text box and a calendar popover that has day, month and year views. It supports single-date or start/end range selection, a configurable separator, and onChange, onDatesChange and onInput callbacks. When wrapped in a Field it connects to the form, formatting, parsing and masking the field's value for its mode and separator.",
  "repository": {
    "type": "github",
    "url": "https://github.com/storm-software/cyclone-ui.git",
    "directory": "components/date-picker"
  },
  "private": false,
  "files": [
    "dist"
  ],
  "peerDependencies": {
    "react": "catalog:",
    "react-dom": "catalog:",
    "react-native": "catalog:"
  },
  "dependencies": {
    "@cyclone-ui/button": "workspace:*",
    "@cyclone-ui/calendar": "workspace:*",
    "@cyclone-ui/field": "workspace:*",
    "@cyclone-ui/helpers": "workspace:*",
    "@cyclone-ui/icons": "workspace:*",
    "@cyclone-ui/input": "workspace:*",
    "@cyclone-ui/popover": "workspace:*",
    "@maskito/core": "catalog:",
    "@maskito/kit": "^3.11.1",
    "@stryke/date": "catalog:",
    "@tamagui/core": "catalog:"
  },
  "devDependencies": {
    "@cyclone-ui/form": "workspace:*",
    "@storybook/react-vite": "catalog:",
    "react": "catalog:",
    "react-dom": "catalog:",
    "react-native": "catalog:"
  },
  "publishConfig": {
    "access": "public"
  },
  "sideEffects": [
    "*.css"
  ],
  "module:jsx": "dist/jsx",
  "main": "./dist/index.cjs",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.cts",
  "exports": {
    ".": {
      "import": "./dist/index.mjs",
      "require": "./dist/index.cjs"
    },
    "./DatePicker": {
      "import": "./dist/DatePicker.mjs",
      "require": "./dist/DatePicker.cjs"
    },
    "./utilities": {
      "import": "./dist/utilities.mjs",
      "require": "./dist/utilities.cjs"
    },
    "./*": "./*"
  }
}
