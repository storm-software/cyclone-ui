{
  "name": "@cyclone-ui/button",
  "version": "0.6.62",
  "type": "module",
  "description": "A pressable button with Button.Text and Button.Icon subcomponents and the Container variants (primary, secondary, tertiary, outlined, sunken, canvas, surface, elevated, floating), whose background is drawn by a Container, plus ghost, link and cascade hover variants. It also has Container shadow styles and glass, noise and accented options. It supports sizes, circular and rounded shapes, ringed and disabled states, press ripples, and rendering as an anchor with href.",
  "repository": {
    "type": "github",
    "url": "https://github.com/storm-software/cyclone-ui.git",
    "directory": "components/button"
  },
  "private": false,
  "files": [
    "dist"
  ],
  "peerDependencies": {
    "react": "catalog:",
    "react-dom": "catalog:",
    "react-native": "catalog:"
  },
  "dependencies": {
    "@cyclone-ui/body-text": "workspace:*",
    "@cyclone-ui/container": "workspace:*",
    "@cyclone-ui/helpers": "workspace:*",
    "@cyclone-ui/ripple-animation": "workspace:*",
    "@cyclone-ui/themeable-icon": "workspace:*",
    "@cyclone-ui/tooltip": "workspace:*",
    "@tamagui/core": "catalog:",
    "@tamagui/helpers": "catalog:",
    "@tamagui/stacks": "catalog:",
    "@tamagui/text": "catalog:"
  },
  "devDependencies": {
    "@cyclone-ui/icons": "workspace:*",
    "@storybook/react-vite": "catalog:",
    "react": "catalog:",
    "react-dom": "catalog:",
    "react-native": "catalog:"
  },
  "publishConfig": {
    "access": "public"
  },
  "sideEffects": [
    "*.css"
  ],
  "module:jsx": "dist/jsx",
  "main": "./dist/index.cjs",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.cts",
  "exports": {
    ".": {
      "import": "./dist/index.mjs",
      "require": "./dist/index.cjs"
    },
    "./Button": {
      "import": "./dist/Button.mjs",
      "require": "./dist/Button.cjs"
    },
    "./*": "./*"
  }
}
