{
  "name": "@cyclone-ui/accordion",
  "version": "0.3.11",
  "type": "module",
  "description": "A collapsible Accordion compound component (Accordion.Item, Item.Header, Header.Heading, Item.Content) built on Tamagui's accordion. It supports single or multiple open items, default, separated, bordered and ghost variants, numbered headers, toggle or chevron icons with a configurable side, and an up or down direction. Use it for FAQs or grouped sections that users expand.",
  "repository": {
    "type": "github",
    "url": "https://github.com/storm-software/cyclone-ui.git",
    "directory": "components/accordion"
  },
  "private": false,
  "peerDependencies": {
    "react": "catalog:",
    "react-dom": "catalog:",
    "react-native": "catalog:"
  },
  "dependencies": {
    "@stryke/type-checks": "catalog:",
    "@stryke/types": "catalog:",
    "@tamagui/accordion": "catalog:",
    "@tamagui/collapsible": "catalog:",
    "@tamagui/core": "catalog:",
    "@tamagui/group": "catalog:",
    "@tamagui/helpers": "catalog:",
    "@cyclone-ui/icons": "workspace:*",
    "@tamagui/stacks": "catalog:",
    "@cyclone-ui/heading-text": "workspace:*",
    "@cyclone-ui/vectors": "workspace:*"
  },
  "devDependencies": {
    "@cyclone-ui/body-text": "workspace:*",
    "@storybook/react-vite": "catalog:",
    "react": "catalog:",
    "react-dom": "catalog:",
    "react-native": "catalog:"
  },
  "publishConfig": {
    "access": "public"
  },
  "module:jsx": "dist/jsx",
  "source": "src/index.ts",
  "main": "./dist/index.cjs",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.cts",
  "exports": {
    ".": {
      "import": "./dist/index.mjs",
      "require": "./dist/index.cjs"
    },
    "./Accordion": {
      "import": "./dist/Accordion.mjs",
      "require": "./dist/Accordion.cjs"
    },
    "./*": "./*"
  }
}
