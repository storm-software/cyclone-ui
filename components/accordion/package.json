{
  "name": "@cyclone-ui/accordion",
  "version": "0.3.83",
  "private": false,
  "description": "A collapsible Accordion compound component (Accordion.Item, Item.Header, Header.Heading, Item.Content) built on Tamagui's accordion. It supports single or multiple open items, the Container variants (primary, secondary, tertiary, outlined, sunken, canvas, surface, elevated, floating) and ghost, shadow, glass, noise and accented options, separated and borderless layouts, numbered headers, toggle or chevron icons with a configurable side, and an up or down direction. Use it for FAQs or grouped sections that users expand.",
  "repository": {
    "type": "github",
    "url": "https://github.com/storm-software/cyclone-ui.git",
    "directory": "components/accordion"
  },
  "type": "module",
  "exports": {
    ".": {
      "import": "./dist/index.mjs",
      "require": "./dist/index.cjs"
    },
    "./Accordion": {
      "import": "./dist/Accordion.mjs",
      "require": "./dist/Accordion.cjs"
    },
    "./*": "./*"
  },
  "main": "./dist/index.cjs",
  "module": "./dist/index.mjs",
  "source": "src/index.ts",
  "types": "./dist/index.d.cts",
  "dependencies": {
    "@cyclone-ui/container": "workspace:*",
    "@cyclone-ui/heading-text": "workspace:*",
    "@cyclone-ui/icons": "workspace:*",
    "@stryke/type-checks": "catalog:",
    "@tamagui/accordion": "catalog:",
    "@tamagui/collapsible": "catalog:",
    "@tamagui/core": "catalog:",
    "@tamagui/group": "catalog:",
    "@tamagui/helpers": "catalog:",
    "@tamagui/react-native-types": "catalog:",
    "@tamagui/stacks": "catalog:"
  },
  "devDependencies": {
    "@cyclone-ui/body-text": "workspace:*",
    "@storybook/react-vite": "catalog:",
    "react": "catalog:",
    "react-dom": "catalog:",
    "react-native": "catalog:"
  },
  "peerDependencies": {
    "react": "catalog:",
    "react-dom": "catalog:",
    "react-native": "catalog:"
  },
  "publishConfig": {
    "access": "public"
  },
  "module:jsx": "dist/jsx"
}
