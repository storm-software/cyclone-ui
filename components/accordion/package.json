{
  "name": "@cyclone-ui/accordion",
  "version": "0.3.0",
  "type": "module",
  "description": "A package containing the Accordion component used by Storm Software",
  "repository": {
    "type": "github",
    "url": "https://github.com/storm-software/cyclone-ui.git",
    "directory": "components/accordion"
  },
  "private": false,
  "peerDependencies": {
    "react": "catalog:",
    "react-dom": "catalog:",
    "react-native": "catalog:"
  },
  "dependencies": {
    "@stryke/type-checks": "catalog:",
    "@stryke/types": "catalog:",
    "@tamagui/accordion": "catalog:",
    "@tamagui/collapsible": "catalog:",
    "@tamagui/core": "catalog:",
    "@tamagui/group": "catalog:",
    "@tamagui/helpers": "catalog:",
    "@tamagui/stacks": "catalog:",
    "@cyclone-ui/heading-text": "workspace:*",
    "@cyclone-ui/vectors": "workspace:*"
  },
  "devDependencies": {
    "@cyclone-ui/body-text": "workspace:*",
    "@storybook/react-vite": "catalog:",
    "react": "catalog:",
    "react-dom": "catalog:",
    "react-native": "catalog:"
  },
  "publishConfig": {
    "access": "public"
  },
  "module:jsx": "dist/jsx",
  "source": "src/index.ts",
  "main": "./dist/index.cjs",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.cts",
  "exports": {
    ".": {
      "import": "./dist/index.mjs",
      "require": "./dist/index.cjs"
    },
    "./Accordion": {
      "import": "./dist/Accordion.mjs",
      "require": "./dist/Accordion.cjs"
    },
    "./*": "./*"
  }
}
