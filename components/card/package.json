{
  "name": "@cyclone-ui/card",
  "version": "0.6.0",
  "type": "module",
  "description": "A repository containing the core front-end components used by Storm Software across many platforms",
  "repository": {
    "type": "github",
    "url": "https://github.com/storm-software/cyclone-ui.git",
    "directory": "components/card"
  },
  "private": false,
  "files": [
    "dist"
  ],
  "peerDependencies": {
    "react": "catalog:",
    "react-dom": "catalog:",
    "react-native": "catalog:"
  },
  "dependencies": {
    "@tamagui/core": "catalog:",
    "@tamagui/font-size": "catalog:",
    "@tamagui/get-font-sized": "catalog:",
    "@tamagui/helpers": "catalog:",
    "@tamagui/helpers-tamagui": "catalog:",
    "@tamagui/linear-gradient": "catalog:",
    "@tamagui/stacks": "catalog:",
    "@tamagui/text": "catalog:",
    "@tamagui/web": "catalog:",
    "@cyclone-ui/body-text": "workspace:*",
    "@cyclone-ui/container": "workspace:*",
    "@cyclone-ui/eyebrow-text": "workspace:*",
    "@cyclone-ui/heading-text": "workspace:*",
    "@cyclone-ui/helpers": "workspace:*",
    "@cyclone-ui/link": "workspace:*",
    "@cyclone-ui/themeable-icon": "workspace:*"
  },
  "devDependencies": {
    "@storybook/react-vite": "catalog:",
    "@tamagui/lucide-icons-2": "catalog:",
    "react": "catalog:",
    "react-dom": "catalog:",
    "react-native": "catalog:",
    "react-native-svg": "^15.15.5"
  },
  "publishConfig": {
    "access": "public"
  },
  "sideEffects": [
    "*.css"
  ],
  "module:jsx": "dist/jsx",
  "main": "./dist/index.cjs",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.cts",
  "exports": {
    ".": {
      "import": "./dist/index.mjs",
      "require": "./dist/index.cjs"
    },
    "./Card": {
      "import": "./dist/Card.mjs",
      "require": "./dist/Card.cjs"
    },
    "./*": "./*"
  }
}
