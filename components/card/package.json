{
  "name": "@cyclone-ui/card",
  "version": "0.6.57",
  "type": "module",
  "description": "A themed card container with a gradient background and an optional accent color. Compound parts include Header (Eyebrow, Heading, Icon), Body and Footer.Link, and the footer link's arrow animates when the card is hovered. Its variant sets the surface (primary, secondary, tertiary, outlined or another Container surface), and cardStyle puts the accent bar on any edge or swaps it for a pixel hover effect. Use it to present a summary or feature with a call-to-action link.",
  "repository": {
    "type": "github",
    "url": "https://github.com/storm-software/cyclone-ui.git",
    "directory": "components/card"
  },
  "private": false,
  "files": [
    "dist"
  ],
  "peerDependencies": {
    "react": "catalog:",
    "react-dom": "catalog:",
    "react-native": "catalog:"
  },
  "dependencies": {
    "@cyclone-ui/body-text": "workspace:*",
    "@cyclone-ui/container": "workspace:*",
    "@cyclone-ui/eyebrow-text": "workspace:*",
    "@cyclone-ui/heading-text": "workspace:*",
    "@cyclone-ui/helpers": "workspace:*",
    "@cyclone-ui/icons": "workspace:*",
    "@cyclone-ui/link": "workspace:*",
    "@cyclone-ui/tag": "workspace:*",
    "@cyclone-ui/themeable-icon": "workspace:*",
    "@cyclone-ui/vectors": "workspace:*",
    "@tamagui/core": "catalog:",
    "@tamagui/get-font-sized": "catalog:",
    "@tamagui/helpers": "catalog:",
    "@tamagui/stacks": "catalog:",
    "@tamagui/web": "catalog:"
  },
  "devDependencies": {
    "@storybook/react-vite": "catalog:",
    "react": "catalog:",
    "react-dom": "catalog:",
    "react-native": "catalog:",
    "react-native-svg": "catalog:"
  },
  "publishConfig": {
    "access": "public"
  },
  "sideEffects": [
    "*.css"
  ],
  "module:jsx": "dist/jsx",
  "main": "./dist/index.cjs",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.cts",
  "exports": {
    ".": {
      "import": "./dist/index.mjs",
      "require": "./dist/index.cjs"
    },
    "./Card": {
      "import": "./dist/Card.mjs",
      "require": "./dist/Card.cjs"
    },
    "./*": "./*"
  }
}
