{
  "name": "@cyclone-ui/heading-text",
  "version": "0.5.11",
  "type": "module",
  "description": "Themed heading text components: HeadingHeroText, HeadingTitleText, HeadingLargeText, HeadingMediumText, HeadingSmallText and HeadingExtraSmallText. Each renders the matching h1-h5 element and has base (display) and editorial font variants. HeadingText picks one of them from a level prop (1-5 or hero/title/lg/md/sm/xs). Use them for consistent page and section titles.",
  "repository": {
    "type": "github",
    "url": "https://github.com/storm-software/cyclone-ui.git",
    "directory": "components/heading-text"
  },
  "private": false,
  "files": ["dist"],
  "peerDependencies": {
    "react": "catalog:",
    "react-dom": "catalog:",
    "react-native": "catalog:"
  },
  "dependencies": {
    "@tamagui/core": "catalog:",
    "@tamagui/get-font-sized": "catalog:",
    "@tamagui/text": "catalog:"
  },
  "devDependencies": {
    "@storybook/react-vite": "catalog:",
    "react": "catalog:",
    "react-dom": "catalog:",
    "react-native": "catalog:"
  },
  "publishConfig": {
    "access": "public"
  },
  "sideEffects": ["*.css"],
  "main": "./dist/index.cjs",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.cts",
  "exports": {
    ".": {
      "import": "./dist/index.mjs",
      "require": "./dist/index.cjs"
    },
    "./HeadingText": {
      "import": "./dist/HeadingText.mjs",
      "require": "./dist/HeadingText.cjs"
    },
    "./*": "./*"
  }
}
