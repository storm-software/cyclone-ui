{
  "name": "@cyclone-ui/file-picker-field",
  "version": "0.5.11",
  "type": "module",
  "description": "A form field that wraps FilePicker, with Label, Control, Details, Link and Icon subcomponents. It lists the selected files, provides an upload trigger button, and reads disabled state, size and the max file count from the field, writing changes back to form state.",
  "repository": {
    "type": "github",
    "url": "https://github.com/storm-software/cyclone-ui.git",
    "directory": "components/file-picker-field"
  },
  "private": false,
  "files": [
    "dist"
  ],
  "peerDependencies": {
    "react": "catalog:",
    "react-dom": "catalog:",
    "react-native": "catalog:"
  },
  "dependencies": {
    "@stryke/types": "catalog:",
    "@tamagui/core": "catalog:",
    "react-native-svg": "^15.15.5",
    "@cyclone-ui/field": "workspace:*",
    "@cyclone-ui/file-picker": "workspace:*",
    "@cyclone-ui/state": "workspace:*"
  },
  "devDependencies": {
    "@cyclone-ui/form": "workspace:*",
    "@storybook/react-vite": "catalog:",
    "react": "catalog:",
    "react-dom": "catalog:",
    "react-native": "catalog:"
  },
  "publishConfig": {
    "access": "public"
  },
  "sideEffects": [
    "*.css"
  ],
  "module:jsx": "dist/jsx",
  "main": "./dist/index.cjs",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.cts",
  "exports": {
    ".": {
      "import": "./dist/index.mjs",
      "require": "./dist/index.cjs"
    },
    "./FilePickerField": {
      "import": "./dist/FilePickerField.mjs",
      "require": "./dist/FilePickerField.cjs"
    },
    "./*": "./*"
  }
}
