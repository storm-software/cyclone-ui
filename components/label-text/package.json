{
  "name": "@cyclone-ui/label-text",
  "version": "0.5.11",
  "type": "module",
  "description": "A text component that renders a label element using the title typography, built on BodyText. A floating variant switches it to a smaller font with an animated transition. Use it for form control labels and other short label text.",
  "repository": {
    "type": "github",
    "url": "https://github.com/storm-software/cyclone-ui.git",
    "directory": "components/label-text"
  },
  "private": false,
  "files": [
    "dist"
  ],
  "peerDependencies": {
    "react": "catalog:",
    "react-dom": "catalog:",
    "react-native": "catalog:"
  },
  "dependencies": {
    "@tamagui/core": "catalog:",
    "@cyclone-ui/body-text": "workspace:*",
    "@cyclone-ui/helpers": "workspace:*"
  },
  "devDependencies": {
    "@storybook/react-vite": "catalog:",
    "react": "catalog:",
    "react-dom": "catalog:",
    "react-native": "catalog:"
  },
  "publishConfig": {
    "access": "public"
  },
  "sideEffects": [
    "*.css"
  ],
  "main": "./dist/index.cjs",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.cts",
  "exports": {
    ".": {
      "import": "./dist/index.mjs",
      "require": "./dist/index.cjs"
    },
    "./LabelText": {
      "import": "./dist/LabelText.mjs",
      "require": "./dist/LabelText.cjs"
    },
    "./*": "./*"
  }
}
