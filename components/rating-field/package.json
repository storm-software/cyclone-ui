{
  "name": "@cyclone-ui/rating-field",
  "version": "0.0.6",
  "type": "module",
  "description": "A form field that wraps the Rating control, with Label, Control, Details and Link subcomponents. It reads value, size and disabled state from the field, reports focus, change and blur to form state, accepts an optional controlled value, and uses the validation color for empty items.",
  "repository": {
    "type": "github",
    "url": "https://github.com/storm-software/cyclone-ui.git",
    "directory": "components/rating-field"
  },
  "private": false,
  "files": [
    "dist"
  ],
  "peerDependencies": {
    "react": "catalog:",
    "react-dom": "catalog:",
    "react-native": "catalog:"
  },
  "dependencies": {
    "@tamagui/core": "catalog:",
    "@cyclone-ui/field": "workspace:*",
    "@cyclone-ui/rating": "workspace:*",
    "@cyclone-ui/state": "workspace:*"
  },
  "devDependencies": {
    "@cyclone-ui/form": "workspace:*",
    "@cyclone-ui/icons": "workspace:*",
    "@storybook/react-vite": "catalog:",
    "react": "catalog:",
    "react-dom": "catalog:",
    "react-native": "catalog:"
  },
  "publishConfig": {
    "access": "public"
  },
  "sideEffects": [
    "*.css"
  ],
  "module:jsx": "dist/jsx",
  "main": "./dist/index.cjs",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.cts",
  "exports": {
    ".": {
      "import": "./dist/index.mjs",
      "require": "./dist/index.cjs"
    },
    "./RatingField": {
      "import": "./dist/RatingField.mjs",
      "require": "./dist/RatingField.cjs"
    },
    "./*": "./*"
  }
}
