{
  "name": "@cyclone-ui/select-field",
  "version": "0.1.11",
  "type": "module",
  "description": "A form-bound SelectField compound component (Label, Link, Control, Details, Icon) that connects a Select dropdown to the Cyclone UI form state. Options are rendered from the field's items, and it shows a floating label by default, a placeholder, formatted values, focus, size and disabled state. Use it to pick a single option inside a Form.",
  "repository": {
    "type": "github",
    "url": "https://github.com/storm-software/cyclone-ui.git",
    "directory": "components/select-field"
  },
  "private": false,
  "files": ["dist"],
  "peerDependencies": {
    "jotai": "catalog:",
    "react": "catalog:",
    "react-dom": "catalog:",
    "react-native": "catalog:"
  },
  "dependencies": {
    "@stryke/types": "catalog:",
    "@tamagui/core": "catalog:",
    "@tamagui/react-native-types": "catalog:",
    "@tamagui/create-context": "catalog:",
    "@tamagui/web": "catalog:",
    "react-native-svg": "^15.15.5",
    "@cyclone-ui/field": "workspace:*",
    "@cyclone-ui/select": "workspace:*",
    "@cyclone-ui/state": "workspace:*"
  },
  "devDependencies": {
    "@cyclone-ui/form": "workspace:*",
    "@storybook/react-vite": "catalog:",
    "jotai": "catalog:",
    "react": "catalog:",
    "react-dom": "catalog:",
    "react-native": "catalog:"
  },
  "publishConfig": {
    "access": "public"
  },
  "sideEffects": ["*.css"],
  "module:jsx": "dist/jsx",
  "main": "./dist/index.cjs",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.cts",
  "exports": {
    ".": {
      "import": "./dist/index.mjs",
      "require": "./dist/index.cjs"
    },
    "./SelectField": {
      "import": "./dist/SelectField.mjs",
      "require": "./dist/SelectField.cjs"
    },
    "./*": "./*"
  }
}
