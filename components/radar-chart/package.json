{
  "name": "@cyclone-ui/radar-chart",
  "version": "0.0.6",
  "type": "module",
  "description": "A composable radar chart built on Recharts and the shared Cyclone chart parts. Series can be filled or drawn as lines over a polygon or circle grid, with glow and point markers. It also supports legend selection and a loading skeleton. Use it to compare several series across the same set of attributes.",
  "repository": {
    "type": "github",
    "url": "https://github.com/storm-software/cyclone-ui.git",
    "directory": "components/radar-chart"
  },
  "private": false,
  "files": [
    "dist"
  ],
  "peerDependencies": {
    "react": "catalog:",
    "react-dom": "catalog:",
    "react-native": "catalog:"
  },
  "dependencies": {
    "@cyclone-ui/chart": "workspace:*",
    "motion": "catalog:",
    "recharts": "catalog:"
  },
  "devDependencies": {
    "@storybook/react-vite": "catalog:",
    "@tamagui/stacks": "catalog:",
    "react": "catalog:",
    "react-dom": "catalog:",
    "react-native": "catalog:"
  },
  "publishConfig": {
    "access": "public"
  },
  "sideEffects": [
    "*.css"
  ],
  "module:jsx": "dist/jsx",
  "main": "./dist/index.cjs",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.cts",
  "exports": {
    ".": {
      "import": "./dist/index.mjs",
      "require": "./dist/index.cjs"
    },
    "./RadarChart": {
      "import": "./dist/RadarChart.mjs",
      "require": "./dist/RadarChart.cjs"
    },
    "./*": "./*"
  }
}
