{
  "name": "@cyclone-ui/pagination",
  "version": "0.8.1",
  "type": "module",
  "description": "A component to support page navigation, next and previous links",
  "repository": {
    "type": "github",
    "url": "https://github.com/storm-software/cyclone-ui.git",
    "directory": "components/pagination"
  },
  "private": false,
  "files": ["dist"],
  "peerDependencies": {
    "react": "catalog:",
    "react-dom": "catalog:",
    "react-native": "catalog:"
  },
  "dependencies": {
    "@tamagui/core": "catalog:",
    "@tamagui/lucide-icons-2": "catalog:",
    "@tamagui/stacks": "catalog:",
    "@tamagui/text": "catalog:",
    "@tamagui/web": "catalog:",
    "react-native-svg": "^15.15.5",
    "@cyclone-ui/button": "workspace:*",
    "@cyclone-ui/next-button": "workspace:*",
    "@cyclone-ui/previous-button": "workspace:*"
  },
  "devDependencies": {
    "@storybook/react-vite": "catalog:",
    "react": "catalog:",
    "react-dom": "catalog:",
    "react-native": "catalog:"
  },
  "publishConfig": {
    "access": "public"
  },
  "sideEffects": ["*.css"],
  "module:jsx": "dist/jsx",
  "main": "./dist/index.cjs",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.cts",
  "exports": {
    ".": {
      "import": "./dist/index.mjs",
      "require": "./dist/index.cjs"
    },
    "./Pagination": {
      "import": "./dist/Pagination.mjs",
      "require": "./dist/Pagination.cjs"
    },
    "./*": "./*"
  }
