{
  "name": "@cyclone-ui/footer",
  "version": "0.0.9",
  "type": "module",
  "description": "A responsive site footer with compound layout parts for an introduction, action, navigation sections, links, a bottom rail with brand, copyright and legal links, and a background logo. It optionally renders an animated terrain backdrop that respects reduced motion and a noise texture overlay. Use it at the bottom of marketing or documentation pages.",
  "repository": {
    "type": "github",
    "url": "https://github.com/storm-software/cyclone-ui.git",
    "directory": "components/footer"
  },
  "private": false,
  "files": ["dist"],
  "peerDependencies": {
    "react": "catalog:",
    "react-dom": "catalog:",
    "react-native": "catalog:"
  },
  "dependencies": {
    "@cyclone-ui/body-text": "workspace:*",
    "@cyclone-ui/heading-text": "workspace:*",
    "@cyclone-ui/link": "workspace:*",
    "@cyclone-ui/vectors": "workspace:*",
    "@tamagui/core": "catalog:",
    "react-native-svg": "^15.15.5"
  },
  "devDependencies": {
    "@storybook/react-vite": "catalog:",
    "@cyclone-ui/icons": "workspace:*",
    "react": "catalog:",
    "react-dom": "catalog:",
    "react-native": "catalog:"
  },
  "publishConfig": {
    "access": "public"
  },
  "sideEffects": ["*.css"],
  "main": "./dist/index.cjs",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.cts",
  "exports": {
    ".": {
      "import": "./dist/index.mjs",
      "require": "./dist/index.cjs"
    },
    "./Footer": {
      "import": "./dist/Footer.mjs",
      "require": "./dist/Footer.cjs"
    },
    "./FooterTerrain": {
      "import": "./dist/FooterTerrain.mjs",
      "require": "./dist/FooterTerrain.cjs"
    },
    "./*": "./*"
  }
}
