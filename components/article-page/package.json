{
  "name": "@cyclone-ui/article-page",
  "version": "0.0.16",
  "type": "module",
  "description": "An ArticlePage layout compound component for blog posts and documentation articles. A Header on its own background holds the breadcrumb, title, summary, cover Media and a Details row with the byline, Share links and tags; it stays in place while the Main sheet scrolls up over it. Main holds the article Content, beside a sticky table of contents and share links on wide screens, and Sections for feedback and recommendations, followed by the page footer.",
  "repository": {
    "type": "github",
    "url": "https://github.com/storm-software/cyclone-ui.git",
    "directory": "components/article-page"
  },
  "private": false,
  "files": [
    "dist"
  ],
  "peerDependencies": {
    "react": "catalog:",
    "react-dom": "catalog:",
    "react-native": "catalog:"
  },
  "dependencies": {
    "@cyclone-ui/body-text": "workspace:*",
    "@cyclone-ui/button": "workspace:*",
    "@cyclone-ui/icons": "workspace:*",
    "@cyclone-ui/table-of-contents": "workspace:*",
    "@tamagui/core": "catalog:"
  },
  "devDependencies": {
    "@cyclone-ui/breadcrumb": "workspace:*",
    "@cyclone-ui/card": "workspace:*",
    "@cyclone-ui/feedback": "workspace:*",
    "@cyclone-ui/footer": "workspace:*",
    "@cyclone-ui/heading-text": "workspace:*",
    "@cyclone-ui/inline-code-text": "workspace:*",
    "@cyclone-ui/link": "workspace:*",
    "@cyclone-ui/tag": "workspace:*",
    "@storybook/react-vite": "catalog:",
    "react": "catalog:",
    "react-dom": "catalog:",
    "react-native": "catalog:"
  },
  "publishConfig": {
    "access": "public"
  },
  "sideEffects": [
    "*.css"
  ],
  "main": "./dist/index.cjs",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.cts",
  "exports": {
    ".": {
      "import": "./dist/index.mjs",
      "require": "./dist/index.cjs"
    },
    "./ArticlePage": {
      "import": "./dist/ArticlePage.mjs",
      "require": "./dist/ArticlePage.cjs"
    },
    "./*": "./*"
  }
}
