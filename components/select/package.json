{
  "name": "@cyclone-ui/select",
  "version": "0.6.1",
  "type": "module",
  "description": "A repository containing the core front-end components used by Storm Software across many platforms",
  "repository": {
    "type": "github",
    "url": "https://github.com/storm-software/cyclone-ui.git",
    "directory": "components/select"
  },
  "private": false,
  "files": ["dist"],
  "peerDependencies": {
    "react": "catalog:",
    "react-dom": "catalog:",
    "react-native": "catalog:"
  },
  "dependencies": {
    "@stryke/types": "catalog:",
    "@tamagui/adapt": "catalog:",
    "@tamagui/compose-refs": "catalog:",
    "@tamagui/constants": "catalog:",
    "@tamagui/core": "catalog:",
    "@tamagui/create-context": "catalog:",
    "@tamagui/focusable": "catalog:",
    "@tamagui/group": "catalog:",
    "@tamagui/helpers-icon": "catalog:",
    "@tamagui/linear-gradient": "catalog:",
    "@tamagui/list-item": "catalog:",
    "@tamagui/lucide-icons-2": "catalog:",
    "@tamagui/select": "catalog:",
    "@tamagui/separator": "catalog:",
    "@tamagui/sheet": "catalog:",
    "@tamagui/stacks": "catalog:",
    "@tamagui/text": "catalog:",
    "@tamagui/web": "catalog:",
    "@cyclone-ui/button": "workspace:*",
    "@cyclone-ui/helpers": "workspace:*",
    "@cyclone-ui/input": "workspace:*"
  },
  "devDependencies": {
    "@cyclone-ui/field": "workspace:*",
    "@cyclone-ui/form": "workspace:*",
    "@storybook/react-vite": "catalog:",
    "react": "catalog:",
    "react-dom": "catalog:",
    "react-native": "catalog:"
  },
  "publishConfig": {
    "access": "public"
  },
  "sideEffects": ["*.css"],
  "module:jsx": "dist/jsx",
  "main": "./dist/index.cjs",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.cts",
  "exports": {
    ".": {
      "import": "./dist/index.mjs",
      "require": "./dist/index.cjs"
    },
    "./Select": {
      "import": "./dist/Select.mjs",
      "require": "./dist/Select.cjs"
    },
    "./SelectItems": {
      "import": "./dist/SelectItems.mjs",
      "require": "./dist/SelectItems.cjs"
    },
    "./SelectTextBox": {
      "import": "./dist/SelectTextBox.mjs",
      "require": "./dist/SelectTextBox.cjs"
    },
    "./SelectValue": {
      "import": "./dist/SelectValue.mjs",
      "require": "./dist/SelectValue.cjs"
    },
    "./utilities": {
      "import": "./dist/utilities.mjs",
      "require": "./dist/utilities.cjs"
    },
    "./*": "./*"
  }
}
