{
  "name": "@cyclone-ui/switch-field",
  "version": "0.1.11",
  "type": "module",
  "description": "A form field that wraps a toggle Switch, with Label, Control, Details and Link subcomponents. It binds checked state, size, focus and disabled state to form state, hides the optional and required markers, and shows a disabled icon next to the label.",
  "repository": {
    "type": "github",
    "url": "https://github.com/storm-software/cyclone-ui.git",
    "directory": "components/switch-field"
  },
  "private": false,
  "files": ["dist"],
  "peerDependencies": {
    "react": "catalog:",
    "react-dom": "catalog:",
    "react-native": "catalog:"
  },
  "dependencies": {
    "@stryke/types": "catalog:",
    "@tamagui/core": "catalog:",
    "@tamagui/stacks": "catalog:",
    "@tamagui/switch-headless": "catalog:",
    "@cyclone-ui/field": "workspace:*",
    "@cyclone-ui/state": "workspace:*",
    "@cyclone-ui/switch": "workspace:*"
  },
  "devDependencies": {
    "@cyclone-ui/form": "workspace:*",
    "@storybook/react-vite": "catalog:",
    "react": "catalog:",
    "react-dom": "catalog:",
    "react-native": "catalog:"
  },
  "publishConfig": {
    "access": "public"
  },
  "sideEffects": ["*.css"],
  "module:jsx": "dist/jsx",
  "main": "./dist/index.cjs",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.cts",
  "exports": {
    ".": {
      "import": "./dist/index.mjs",
      "require": "./dist/index.cjs"
    },
    "./SwitchField": {
      "import": "./dist/SwitchField.mjs",
      "require": "./dist/SwitchField.cjs"
    },
    "./*": "./*"
  }
}
