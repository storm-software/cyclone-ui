{
  "name": "tools-nx",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "tools/nx/src",
  "projectType": "library",
  "targets": {
    "build-untyped": {
      "cache": true,
      "executor": "nx:run-commands",
      "dependsOn": ["^build"],
      "inputs": [
        "{projectRoot}/src/**/untyped.ts",
        "{projectRoot}/src/**/*.untyped.ts"
      ],
      "outputs": [
        "{projectRoot}/src/**/schema.d.ts",
        "{projectRoot}/src/**/*.schema.d.ts",
        "{projectRoot}/src/**/schema.md",
        "{projectRoot}/src/**/*.schema.md",
        "{projectRoot}/src/**/schema.json",
        "{projectRoot}/src/**/*.schema.json"
      ],
      "options": {
        "commands": [
          "storm-untyped generate --entry=\"tools/nx/src/**/{untyped.ts,*.untyped.ts}\""
        ]
      }
    },
    "build": {
      "cache": true,
      "inputs": ["typescript", "^production"],
      "outputs": ["{projectRoot}/dist", "{workspaceRoot}/dist/tools/nx"],
      "executor": "nx:run-commands",
      "dependsOn": ["build-base", "build-untyped", "typecheck"],
      "options": {
        "commands": [
          "pnpm copyfiles LICENSE dist/tools/nx",
          "pnpm copyfiles --up=3 \"tools/nx/*.md\" tools/nx/executors.json tools/nx/generators.json tools/nx/package.json dist/tools/nx",
          "pnpm copyfiles --up=4 \"tools/nx/src/executors/*/schema.json\" \"tools/nx/src/executors/*/schema.d.ts\" \"tools/nx/src/generators/*/schema.json\" \"tools/nx/src/generators/*/schema.d.ts\" tools/nx/dist/src",
          "pnpm copyfiles --up=4 \"tools/nx/src/base/*.schema.json\" \"tools/nx/src/base/*.schema.d.ts\" dist/tools/nx/dist/src",
          "pnpm copyfiles --up=4 \"tools/nx/dist/src/**/*\" dist/tools/nx/dist",
          "pnpm copyfiles --up=5 \"tools/nx/src/**/*.md\" dist/tools/nx/docs/api"
        ],
        "parallel": false
      }
    }
  }
}
