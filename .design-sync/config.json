{
  "projectId": "ff43a5f9-51a9-4984-b2fe-72ef229c9195",
  "shape": "storybook",
  "storybookConfigDir": "apps/storybook/.storybook",
  "storybookStatic": ".design-sync/sb-reference",
  "pkg": "@cyclone-ui/design-sync",
  "globalName": "CycloneUI",
  "entry": ".design-sync/pkg/dist/index.mjs",
  "buildCmd": "devenv shell -- pnpm nx run-many -t build -p accordion,alert,alert-dialog,anchor,badge,body-text,breadcrumb,button,bytes-text,callout,card,checkbox,circular-progress,code-block,collapsible,container,data-table,date-picker,dialog,divider,drawer,eyebrow-text,feedback,field,file-picker,file-tree,footer,form,glitch-separator,heading-text,icons,inline-code-text,input,label-text,like-button,link,link-text,message,navigation-header,next-button,number-input,number-text,otp-input,package-command-code-block,page,pagination,password-input,pdf-document-display,phone-number-input,popover,previous-button,progress,radio-group,rating,redacted-animation,scroll-view,search-input,select,sheet,slider,spinner,stepper,switch,table,table-of-contents,tabs,tag,tag-picker,text-area,themeable-gradient,themeable-icon,tooltip,type-table,validation-text,vectors,visually-hidden,state,themes && node .design-sync/pkg/build.mjs",
  "storyImports": {
    "shim": [
      "/@tamagui/core/",
      "/@tamagui/web/",
      "/@tamagui/stacks/",
      "/components/",
      "/packages/state/",
      "@stryke/date"
    ],
    "loaders": {
      ".mjs": "jsx"
    }
  },
  "provider": {
    "component": "SafeAreaProvider",
    "props": {
      "initialMetrics": {
        "frame": {
          "x": 0,
          "y": 0,
          "width": 0,
          "height": 0
        },
        "insets": {
          "top": 0,
          "left": 0,
          "right": 0,
          "bottom": 0
        }
      }
    },
    "inner": {
      "component": "TamaguiProvider",
      "props": {
        "config": {
          "$ref": "tamaguiConfig"
        },
        "defaultTheme": "dark",
        "disableInjectCSS": false
      },
      "inner": {
        "component": "Theme",
        "props": {
          "name": "dark_base"
        },
        "inner": {
          "component": "PortalProvider",
          "props": {},
          "inner": {
            "component": "MessageProvider",
            "props": {}
          }
        }
      }
    }
  },
  "overrides": {
    "Checkbox": {
      "cardMode": "column"
    },
    "RadioGroup": {
      "cardMode": "column"
    },
    "Switch": {
      "cardMode": "column"
    },
    "Card": {
      "cardMode": "column"
    },
    "Dialog": {
      "cardMode": "single"
    },
    "Callout": {
      "cardMode": "column"
    },
    "Select": {
      "cardMode": "single"
    },
    "Tag": {
      "skip": [
        "triggers-tag--removable"
      ]
    },
    "Form": {
      "skip": [
        "form-sizing--all-sizes",
        "form-sizing--disabled",
        "form-sizing--changing-size-prop",
        "form-form--base",
        "form-form--small",
        "form-form--large",
        "form-form--brand",
        "form-form--discovery",
        "form-form--error",
        "form-form--warning",
        "form-form--info",
        "form-form--success"
      ]
    },
    "FilePicker": {
      "cardMode": "column"
    },
    "TagPicker": {
      "cardMode": "column"
    },
    "Stepper": {
      "cardMode": "column"
    },
    "FileTree": {
      "cardMode": "column"
    },
    "TableOfContents": {
      "cardMode": "column"
    },
    "TypeTable": {
      "cardMode": "column"
    },
    "CheckboxField": {
      "cardMode": "column"
    },
    "PasswordInputField": {
      "cardMode": "column"
    },
    "SwitchField": {
      "cardMode": "column"
    },
    "TagPickerField": {
      "cardMode": "column",
      "skip": [
        "form-tagpickerfield--base"
      ]
    },
    "DataTable": {
      "cardMode": "column"
    },
    "Table": {
      "cardMode": "column"
    },
    "Breadcrumb": {
      "cardMode": "column"
    },
    "CheckerBoard": {
      "cardMode": "column"
    },
    "StormLogoIcon": {
      "cardMode": "column"
    },
    "StormLogoText": {
      "cardMode": "column"
    },
    "NavigationHeader": {
      "cardMode": "single",
      "primaryStory": "Default"
    },
    "Drawer": {
      "cardMode": "single"
    },
    "DatePicker": {
      "cardMode": "single"
    },
    "DatePickerField": {
      "cardMode": "single"
    },
    "Message": {
      "cardMode": "column"
    },
    "CodeBlock": {
      "cardMode": "column"
    },
    "Page": {
      "cardMode": "single",
      "primaryStory": "Default"
    },
    "AlertDialog": {
      "cardMode": "single"
    },
    "Sheet": {
      "cardMode": "single"
    },
    "ThemeableIcon": {
      "skip": [
        "base-themeableicon--base",
        "base-themeableicon--brand",
        "base-themeableicon--discovery",
        "base-themeableicon--error",
        "base-themeableicon--warning",
        "base-themeableicon--info",
        "base-themeableicon--success",
        "base-themeableicon--disabled"
      ]
    },
    "VisuallyHidden": {
      "skip": [
        "base-visuallyhidden--base",
        "base-visuallyhidden--animate"
      ]
    },
    "SelectField": {
      "cardMode": "single"
    }
  },
  "readmeHeader": ".design-sync/conventions.md",
  "titleMap": {
    "Icons": null,
    "Sizing": null
  },
  "libOverrides": {
    "preview-gen-storybook.mjs": "ctx.id is unique per story so Field stories (<Form name={`formName-${id}`}>) get separate form stores in grid cards"
  }
}
