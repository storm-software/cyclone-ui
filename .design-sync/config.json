{
  "projectId": "ff43a5f9-51a9-4984-b2fe-72ef229c9195",
  "shape": "storybook",
  "storybookConfigDir": "apps/storybook/.storybook",
  "storybookStatic": ".design-sync/sb-reference",
  "pkg": "@cyclone-ui/design-sync",
  "globalName": "CycloneUI",
  "entry": ".design-sync/pkg/dist/index.mjs",
  "buildCmd": "devenv shell -- pnpm nx run-many -t build -p accordion,address-input,alert,alert-dialog,anchor,area-chart,article-page,badge,bar-chart,body-text,breadcrumb,button,bytes-text,calendar,callout,card,chart,checkbox,circular-progress,code-block,collapsible,color-area,color-compositions,color-picker,composed-chart,confetti-burst,container,context-menu,credit-card-input,data-table,date-picker,dialog,divider,docs-page,drawer,eyebrow-text,feedback,field,file-picker,file-tree,footer,form,glitch-separator,heading-text,icons,inline-code-text,input,like-button,line-chart,link,link-text,message,modal,navigation-header,next-button,number-input,number-text,otp-input,overlay,package-command-code-block,page,pagination,password-input,pdf-document-display,phone-number-input,pie-chart,popover,preview-link,previous-button,privacy-choices,progress,radar-chart,radial-chart,radio-group,rating,redacted-animation,ripple-animation,sankey-chart,scramble-animation,scroll-view,search-dialog,search-input,select,sheet,skeleton,slider,spinner,stepper,switch,table,table-of-contents,tabs,tag,tag-picker,text-area,themeable-gradient,themeable-icon,timeline,time-picker,toggle,toggle-group,tooltip,type-table,validation-text,vectors,visually-hidden,state,tokens && node .design-sync/pkg/build.mjs",
  "storyImports": {
    "shim": [
      "/@tamagui/core/",
      "/@tamagui/web/",
      "/@tamagui/stacks/",
      "/components/",
      "/packages/state/",
      "@stryke/date"
    ],
    "loaders": {
      ".mjs": "jsx"
    }
  },
  "provider": {
    "component": "SafeAreaProvider",
    "props": {
      "initialMetrics": {
        "frame": {
          "x": 0,
          "y": 0,
          "width": 0,
          "height": 0
        },
        "insets": {
          "top": 0,
          "left": 0,
          "right": 0,
          "bottom": 0
        }
      }
    },
    "inner": {
      "component": "TamaguiProvider",
      "props": {
        "config": {
          "$ref": "tamaguiConfig"
        },
        "defaultTheme": "dark",
        "disableInjectCSS": false
      },
      "inner": {
        "component": "Theme",
        "props": {
          "name": "dark_base"
        },
        "inner": {
          "component": "PortalProvider",
          "props": {},
          "inner": {
            "component": "MessageProvider",
            "props": {}
          }
        }
      }
    }
  },
  "overrides": {
    "Checkbox": {
      "cardMode": "column"
    },
    "RadioGroup": {
      "cardMode": "column"
    },
    "Switch": {
      "cardMode": "column"
    },
    "Card": {
      "cardMode": "column"
    },
