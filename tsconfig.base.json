{
  "$schema": "https://json.schemastore.org/tsconfig",
  "extends": "@powerlines/tsconfig/recommended.json",
  "display": "Cyclone UI - Base Configuration",
  "compilerOptions": {
    "incremental": true,
    "composite": true,
    // Load referenced projects as files are opened instead of expanding the workspace graph.
    "disableReferencedProjectLoad": true,
    "sourceMap": true,
    "isolatedModules": true,
    "verbatimModuleSyntax": true,
    "paths": {
      "@fonts/*": ["./fonts/*"]
    }
  }
}
