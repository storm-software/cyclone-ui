<?xml version='1.0' encoding='UTF-8'?>
<designspace format="3">
  <axes>
    <axis default="400" maximum="700" minimum="100" name="weight" tag="wght">
      <map input="100" output="-925" />
      <map input="200" output="-706" />
      <map input="300" output="-360" />
      <map input="400" output="0" />
      <map input="450" output="191" />
      <map input="500" output="427" />
      <map input="600" output="705" />
      <map input="700" output="1000" />
    </axis>
  </axes>
  <sources>
    <source familyname="Storm Sans" filename="StormSans-Thin.ufo" stylename="Thin">
      <location>
        <dimension name="weight" xvalue="-925" />
      </location>
    </source>
    <source familyname="Storm Sans" filename="StormSans-Regular.ufo" stylename="Regular">
      <lib copy="1" />
      <groups copy="1" />
      <info copy="1" />
      <location>
        <dimension name="weight" xvalue="0" />
      </location>
    </source>
    <source familyname="Storm Sans" filename="StormSans-Bold.ufo" stylename="Bold">
      <location>
        <dimension name="weight" xvalue="1000" />
