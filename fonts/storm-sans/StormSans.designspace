  <rules>
    <rule name="rvrn_01">
      <conditionset>
        <condition minimum="-925" maximum="-360" name="weight" />
      </conditionset>
      <sub name="naira" with="naira.rvrn" />
      <sub name="won" with="won.rvrn" />
