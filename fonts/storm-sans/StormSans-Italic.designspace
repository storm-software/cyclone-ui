    <instance familyname="Storm Sans" postscriptfontname="StormSans-MediumItalic" stylename="Medium Italic" stylemapfamilyname="Storm Sans Medium" stylemapstylename="italic" filename="instances/StormSans-MediumItalic.ufo">
      <location>
