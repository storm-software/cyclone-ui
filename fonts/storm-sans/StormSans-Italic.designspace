    <instance familyname="Storm Sans" postscriptfontname="StormSans-SemiBoldItalic" stylename="SemiBold Italic" stylemapfamilyname="Storm Sans SemiBold" stylemapstylename="italic" filename="instances/StormSans-SemiBoldItalic.ufo">
