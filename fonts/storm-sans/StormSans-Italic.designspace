    <instance familyname="Storm Sans" postscriptfontname="StormSans-TextItalic" stylename="Text Italic" stylemapfamilyname="Storm Sans Text" stylemapstylename="italic" filename="instances/StormSans-TextItalic.ufo">
      <location>
