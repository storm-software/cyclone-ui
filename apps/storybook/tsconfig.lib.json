{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "tsBuildInfoFile": "out-tsc/tsconfig.tsbuildinfo",
    "rootDir": ".",
    "paths": {
      "@cyclone-ui/state": ["../../packages/state/src/index.ts"],
      "@cyclone-ui/state/client": ["../../packages/state/src/client/index.ts"],
      "@cyclone-ui/state/form": ["../../packages/state/src/form/index.ts"],
      "@cyclone-ui/state/message": [
        "../../packages/state/src/message/index.ts"
      ],
      "@cyclone-ui/state/theme": ["../../packages/state/src/theme/index.ts"]
    },
    "types": ["node", "react", "vite/client"],
    "outDir": "./out-tsc"
  },
  "references": [
    {
      "path": "../../components/text-area-field"
    },
    {
      "path": "../../components/switch-field"
    },
    {
      "path": "../../components/select-field"
    },
    {
      "path": "../../components/radio-group-field"
    },
    {
      "path": "../../components/otp-input-field"
    },
    {
      "path": "../../components/input-field"
    },
    {
      "path": "../../components/file-picker-field"
    },
    {
      "path": "../../components/date-picker-field"
    },
    {
      "path": "../../components/checkbox-field"
    },
    {
      "path": "../../components/form"
    },
    {
      "path": "../../packages/helpers"
    },
    {
      "path": "../../packages/themes"
    },
    {
      "path": "../../packages/state/tsconfig.lib.json"
    }
  ],
  "include": [
    "src/**/*.ts",
    "src/**/*.js",
    "src/**/*.mjs",
    "src/**/*.cjs",
    "src/**/*.tsx",
    "src/**/*.jsx",
    "src/**/*.mts",
    "src/**/*.cts",
    ".storybook/**/*.ts",
    ".storybook/**/*.tsx",
    "tamagui.config.ts",
    "types/*.d.ts",
    "package.json"
  ],
  "exclude": ["vitest.config.mts", "src/**/*.spec.ts", "src/**/*.test.ts"]
}
