{
  "name": "@cyclone-ui/nx",
  "version": "0.3.0",
  "description": "🌀 A repository containing [Tamagui](https://github.com/tamagui/tamagui) based design components used by Storm Software. Like [shadcn/ui](https://github.com/shadcn-ui/ui), the components are copied into other repositories via the Cyclone CLI.",
  "repository": {
    "type": "github",
    "url": "https://github.com/storm-software/cyclone-ui",
    "directory": "apps/nx"
  },
  "homepage": "https://stormsoftware.com",
  "bugs": {
    "url": "https://github.com/storm-software/cyclone-ui/issues",
    "email": "support@stormsoftware.com"
  },
  "author": {
    "name": "Storm Software",
    "email": "contact@stormsoftware.com",
    "url": "https://stormsoftware.com"
  },
  "license": "Apache-2.0",
  "private": false,
  "main": "./index.js",
  "exports": {
    ".": "./index.js",
    "./package.json": "./package.json",
    "./migrations.json": "./migrations.json",
    "./generators.json": "./generators.json",
    "./generators/*/schema.json": "./src/generators/*/schema.json",
    "./executors.json": "./executors.json",
    "./executors/*/schema.json": "./src/executors/*/schema.json"
  },
  "typings": "./declarations.d.ts",
  "keywords": [
    "nx",
    "nx-plugin",
    "storm-software"
  ],
  "dependencies": {
    "@nx/devkit": "catalog:",
    "@powerlines/nx": "catalog:",
    "@storm-software/config": "catalog:",
    "@storm-software/config-tools": "catalog:",
    "@storm-software/workspace-tools": "catalog:",
    "@stryke/hash": "catalog:",
    "@stryke/path": "catalog:",
    "@stryke/string-format": "catalog:",
    "@stryke/type-checks": "catalog:",
    "defu": "catalog:",
    "jiti": "catalog:",
    "powerlines": "catalog:",
    "untyped": "catalog:"
  },
  "devDependencies": {
    "@powerlines/plugin-tsdown": "catalog:",
    "@powerlines/plugin-untyped": "catalog:",
    "@storm-software/testing-tools": "catalog:",
    "@types/node": "catalog:",
    "eslint-flat-config-utils": "catalog:",
    "jsonc-eslint-parser": "catalog:",
    "nx": ">=22.7.0"
  },
  "peerDependencies": {
    "nx": ">=22.7.0"
  },
  "publishConfig": {
    "access": "public"
  },
  "executors": "./executors.json",
  "generators": "./generators.json"
}
